n:
d rex[va h[a] c vb h[a a] c] c[w[f vc a[y[c[v va][v vc]][u[c[v vb][v vc v vc]]]]][f vd a[f ve a[f vf a[y[w[c[v va][v vd]][w[c[v va][v ve]][w[c[v va][v vf]][w[c[v vb][v vd v ve]][c[v vb][v ve v vf]]]]]][c[v vb][v vd v vf]]]]]]].
d rey[va a vb a vc h[a] c vd h[a a] c] c[w[k rex[v vc v vd]][w[c[v vc][v va]][w[c[v vc][v vb]][c[v vd][v va v vb]]]]].
d rez[va a vb a vc a vd a ve a vf d vg h[a a d] c vh h[a a a d] c vi h[a a a d] c] c[w[u[e[v va][v vb]]][w[k rey[v vc v vd i[vj a][c[v vg][v vj v ve v vf]] i[vk a vl a][c[v vi][v vk v vl v ve v vf]]]][w[c[v vh][v va v vc v ve v vf]][c[v vh][v vb v vd v ve v vf]]]]].
