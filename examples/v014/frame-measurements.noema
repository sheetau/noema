n:
d sgf[va h[a] c vb h[a] c vc h[a a] c] c[w[g vd a[c[v va][v vd]]][w[g ve a[c[v vb][v ve]]][f vf a[f vg a[y[w[c[v va][v vf]][c[v vb][v vg]]][c[v vc][v vf v vg]]]]]]].
d sgg[va h[a] c vb h[a] c vc h[a a] c vd h[a] c ve h[a a] c vf a] c[w[c[v vb][v vf]][f vg a[y[c[v vb][v vg]][w[c[v vd][v vg]][w[g vh a[w[c[v va][v vh]][c[v vc][v vg v vh]]]][w[f vi a[y[c[v vc][v vg v vi]][c[v va][v vi]]]][c[v ve][v vg v vf]]]]]]]].
d sgh[va a vb h[a] c vc h[a a] c] c[g vd a[w[c[v vb][v vd]][c[v vc][v vd v va]]]].
d sgi[va h[a] c vb h[a] c vc h[a a] c vd h[a] c ve h[a a] c vf h[a a] c] c[f vg a[f vh a[y[w[c[v va][v vg]][w[k sgh[v vg v vb v vc]][w[c[v vd][v vh]][c[v ve][v vh v vg]]]]][c[v vf][v vh v vg]]]]].
