n:
d rdm[va a vb a vc a vd a ve i[h[a a] e] vf c vg d vh h[a a a a i[h[a a] e] c d] c vi h[a a a a i[h[a a] e] c d] c] c[w[c[v vi][v va v vb v vc v vd v ve v vf v vg]][u[c[v vh][v va v vb v vc v vd v ve u[v vf] v vg]]]].
d rdr[va j[a] vb b] c[e[d[v va]][v vb]].
d rlt[va i[h[j[a]] e] vb h[a a i[h[j[a]] e] j[a] d] c vc h[a d] c vd h[a a d] c ve h[a a d] c] h[a a] e[i[vf a vg a][b vh[w[c[v vc][v vg v vh]][w[c[v vd][v vf v vg v vh]][w[c[v ve][v vf v vg v vh]][c[v vb][v vf v vg v va l[a][v vf] v vh]]]]]]].
d rlu[va h[a] e] h[j[a]] e[i[vb j[a]][b vc[w[k rdr[v vb n p b b]][g vd a[w[a[v vb][n p a b][v vd]][t[c[v va][v vd]][v vc]]]]]]].
d rlv[va a vb a vc a vd a ve i[h[a a] e] vf d vg h[a a d] c vh h[a a d d] c vi h[a a a a i[h[a a] e] c d] c vj h[a a a a i[h[a a] e] c d] c] c[w[k rdm[v va v vb v vc v vd v ve e[n p a b][n p a b] v vf v vi v vj]][w[c[v vg][v vb v vd v vf]][g vk d[w[c[v vh][v vb v vd v vf v vk]][t[c[s[v ve]][v vb v vd]][v vk]]]]]].
d rlw[va a vb a vc a vd a ve i[h[a a] e] vf d vg h[a a d] c vh h[a a d d] c vi h[a a a a i[h[a a] e] c d] c vj h[a a a a i[h[a a] e] c d] c] c[w[k rlv[v va v vb v vc v vd v ve v vf v vg v vh v vi v vj]][k rdm[v va v vb v vc v vd v ve u[e[n p a b][n p a b]] v vf v vi v vj]]].
d rlx[va h[a] c vb h[a] e vc d] c[w[g vd a[c[v va][v vd]]][f ve a[y[c[v va][v ve]][t[c[v vb][v ve]][v vc]]]]].
