n:
d rlg[va a vb a vc a vd i[h[j[a]] e] ve j[a] vf d vg h[a a d] c vh h[a a d] c vi h[a i[h[j[a]] e] j[a] d] c vj h[a d d] c] c[w[c[v vg][v va v vb v vf]][w[c[v vh][v vb v vc v vf]][w[c[v vi][v vb v vd v ve v vf]][w[g vk d[c[v vj][v vb v vf v vk]]][f vl d[y[c[v vj][v vb v vf v vl]][t[c[s[v vd]][v ve]][v vl]]]]]]]].
d rpb[va i[h[j[a]] e] vb i[h[j[a]] e] vc j[a] vd h[d] c] c[g ve d[w[c[v vd][v ve]][u[e[t[c[s[v va]][v vc]][v ve]][t[c[s[v vb]][v vc]][v ve]]]]]].
d rpe[va a vb a vc a vd i[h[j[a]] e] ve i[h[j[a]] e] vf d vg h[a a d] c vh h[a a d] c vi h[a i[h[j[a]] e] j[a] d] c vj h[a d d] c vk h[d] c] c[w[k rlg[v va v vb v vc v vd l[a][v vc] v vf v vg v vh v vi v vj]][k rpb[v vd v ve l[a][v vc] v vk]]].
d rpi[va i[h[j[a]] e]] h[a] f[i[vb a][j s[c[s[v va]][l[a][v vb]]]]].
d rpj[va a vb a vc a vd i[h[j[a]] e] ve i[h[j[a]] e] vf d vg h[a a d] c vh h[a a d] c vi h[a i[h[j[a]] e] j[a] d] c vj h[a d d] c vk h[d] c vl a vm h[a i[h[j[a]] e] d] c] c[w[k rpe[v va v vb v vc v vd v ve v vf v vg v vh v vi v vj v vk]][c[v vm][v vl v ve v vf]]].
d rpk[va h[a d] c vb h[a a] e vc i[e] vd h[a a i[e] d] c] h[a a] e[i[ve a vf a][b vg[w[c[v va][v ve v vg]][w[t[c[v vb][v ve v vf]][v vg]][c[v vd][v ve v vf v vc v vg]]]]]].
