d rdr[va j[a] vb b] c[e[d[v va]][v vb]].
d rlg[va a vb a vc a vd i[h[j[a]] e] ve j[a] vf d vg h[a a d] c vh h[a a d] c vi h[a i[h[j[a]] e] j[a] d] c vj h[a d d] c] c[w[c[v vg][v va v vb v vf]][w[c[v vh][v vb v vc v vf]][w[c[v vi][v vb v vd v ve v vf]][w[g vk d[c[v vj][v vb v vf v vk]]][f vl d[y[c[v vj][v vb v vf v vl]][t[c[s[v vd]][v ve]][v vl]]]]]]]].
