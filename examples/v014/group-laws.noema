n:
d s4t[va h[a] c vb h[a a] a] c[f vc a[f vd a[y[w[c[v va][v vc]][c[v va][v vd]]][c[v va][c[v vb][v vc v vd]]]]]].
d s4u[va h[a] c vb h[a a] a] c[f vc a[f vd a[f ve a[y[w[c[v va][v vc]][w[c[v va][v vd]][c[v va][v ve]]]][e[c[v vb][c[v vb][v vc v vd] v ve]][c[v vb][v vc c[v vb][v vd v ve]]]]]]]].
d s4v[va h[a] c vb h[a a] a vc a] c[w[c[v va][v vc]][f vd a[y[c[v va][v vd]][w[e[c[v vb][v vc v vd]][v vd]][e[c[v vb][v vd v vc]][v vd]]]]]].
d s4w[va h[a] c vb h[a a] a vc a vd h[a] a] c[f ve a[y[c[v va][v ve]][w[c[v va][c[v vd][v ve]]][w[e[c[v vb][v ve c[v vd][v ve]]][v vc]][e[c[v vb][c[v vd][v ve] v ve]][v vc]]]]]].
d s4x[va h[a] c vb h[a a] a vc a vd h[a] a] c[w[k s4t[v va v vb]][w[k s4u[v va v vb]][w[k s4v[v va v vb v vc]][k s4w[v va v vb v vc v vd]]]]].
