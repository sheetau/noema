n:
d sap[va a vb a vc a vd a ve h[a a a] c vf h[a a] c] c[w[g vg a[c[v ve][v va v vb v vg]]][w[g vh a[c[v ve][v va v vc v vh]]][f vi a[f vj a[y[w[c[v ve][v va v vb v vi]][c[v ve][v va v vc v vj]]][z[c[v vf][v vd v vi]][c[v vf][v vd v vj]]]]]]]].
d saq[va a vb a vc a vd h[a] c ve h[a a a] c vf h[a a] c] c[w[g vg a[c[v vd][v vg]]][f vh a[y[c[v vd][v vh]][k sap[v vh v va v vb v vc v ve v vf]]]]].
d sar[va a vb a vc h[a] c vd h[a] c ve h[a a a] c vf h[a a] c] c[w[g vg a[c[v vc][v vg]]][f vh a[y[c[v vc][v vh]][k saq[v va v vb v vh v vd v ve v vf]]]]].
