n:
d rac[va j[a] vb a] c[q[v va][u[e[n p a b][n p a b]]][i[vc c vd a][x[v vc][e[v vd][v vb]]]]].
d rad[va j[a] vb h[a a] c] h[a a] c[q[v va][i[vc a vd a][w[k rac[v va v vc]][w[k rac[v va v vd]][x[e[v vc][v vd]][c[v vb][v vc v vd]]]]]][i[ve h[a a] c vf a][i[vg a vh a][x[c[v ve][v vg v vh]][w[c[v ve][v vg v vf]][c[v ve][v vf v vh]]]]]]].
d rae[va j[a] vb h[a] c vc h[a] c] c[f vd a[y[k rac[v va v vd]][u[w[c[v vb][v vd]][c[v vc][v vd]]]]]].
d raf[va j[a] vb h[a a] c vc a vd h[a] c] c[g ve a[w[k rac[v va v ve]][w[c[v vd][v ve]][c[k rad[v va v vb]][v vc v ve]]]]].
d rag[va j[a] vb h[a] c vc h[a] c vd h[a a] c ve h[a a] c vf a] c[w[k rae[v va v vb v vc]][w[k rac[v va v vf]][w[c[v vb][v vf]][w[k raf[v va v vd v vf v vc]][u[k raf[v va i[vg a vh a][w[c[v vd][v vg v vh]][u[c[v ve][v vg v vh]]]] v vf v vc]]]]]]].
