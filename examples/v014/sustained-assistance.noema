d sewm[va h[d] c vb h[d d] c] c[w[g vc d[c[v va][v vc]]][w[f vd d[y[c[v va][v vd]][u[c[v vb][v vd v vd]]]]][w[f ve d[f vf d[y[w[c[v va][v ve]][w[c[v va][v vf]][u[e[v ve][v vf]]]]][x[c[v vb][v ve v vf]][c[v vb][v vf v ve]]]]]][f vg d[f vh d[f vi d[y[w[c[v va][v vg]][w[c[v va][v vh]][w[c[v va][v vi]][w[c[v vb][v vg v vh]][c[v vb][v vh v vi]]]]]][c[v vb][v vg v vi]]]]]]]]].
