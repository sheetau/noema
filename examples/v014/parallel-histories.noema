n:
d sfo[va a vb h[a] c vc h[a a a] c vd h[a a] c] c[w[g ve a[c[v vb][v ve]]][f vf a[y[c[v vb][v vf]][w[g vg a[c[v vc][v va v vf v vg]]][f vh a[f vi a[y[w[c[v vc][v va v vf v vh]][c[v vc][v va v vf v vi]]][c[v vd][v vh v vi]]]]]]]]].
d sfp[va a vb h[a] c vc h[a a a] c vd h[a a] c ve h[a a] c] c[w[k sfo[v va v vb v vc v vd]][f vf a[f vg a[y[w[c[v vb][v vf]][c[v vc][v va v vf v vg]]][c[v ve][v vf v vg]]]]]].
d sfq[va h[a] c vb h[a] c vc h[a a a] c vd h[a a] c ve h[a a] c] c[g vf a[w[c[v vb][v vf]][k sfp[v vf v va v vc v vd v ve]]]].
d sfr[va h[a] c vb h[a] c vc h[a a a] c vd h[a a] c ve h[a a] c] c[w[g vf a[c[v va][v vf]]][f vg a[y[c[v va][v vg]][g vh a[w[c[v vb][v vh]][w[k sfo[v vh v va v vc v vd]][g vi a[w[c[v vc][v vh v vg v vi]][c[v ve][v vg v vi]]]]]]]]]].
d sfs[va h[a] c vb h[a] a vc h[a] a vd h[a] c] c[w[g ve a[c[v va][v ve]]][f vf a[y[c[v va][v vf]][w[c[v va][c[v vb][v vf]]][w[c[v va][c[v vc][v vf]]][w[e[c[v vc][c[v vb][v vf]]][v vf]][w[e[c[v vb][c[v vc][v vf]]][v vf]][z[c[v vd][v vf]][c[v vd][c[v vb][v vf]]]]]]]]]]].
