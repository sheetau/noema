n:
d rfe[va a vb i[h[a a] e] vc a vd a ve a vf d vg h[a a a a i[h[a a] e] c d] c] c[w[y[c[v vg][v va v vc v vd v ve v vb e[n p a b][n p a b] v vf]][t[c[s[v vb]][v vc v ve]][v vf]]][y[c[v vg][v va v vc v vd v ve v vb u[e[n p a b][n p a b]] v vf]][u[t[c[s[v vb]][v vc v ve]][v vf]]]]].
d rff[va h[a] c vb j[i[h[a a] e]] vc a vd a ve a vf d vg h[a a a a i[h[a a] e] c d] c] c[f vh a[y[c[v va][v vh]][q[v vb][e[n p a b][n p a b]][i[vi c vj i[h[a a] e]][w[v vi][k rfe[v vh v vj v vc v vd v ve v vf v vg]]]]]]].
d rfg[va a vb a vc a vd d ve h[a a a a i[h[a a] e] c d] c] c[f vf a[f vg i[h[a a] e][k rfe[v vf v vg v va v vb v vc v vd v ve]]]].
d rfh[va h[a] c vb j[i[h[a a] e]] vc a vd a ve a vf d vg h[a a a a i[h[a a] e] c d] c] c[f vh a[f vi i[h[a a] e][y[x[c[v vg][v vh v vc v vd v ve v vi e[n p a b][n p a b] v vf]][c[v vg][v vh v vc v vd v ve v vi u[e[n p a b][n p a b]] v vf]]][w[c[v va][v vh]][q[v vb][u[e[n p a b][n p a b]]][i[vj c vk i[h[a a] e]][x[v vj][e[v vk][v vi]]]]]]]]].
d rfi[va h[a] c vb j[i[h[a a] e]] vc a vd a ve a vf d vg h[a a a a i[h[a a] e] c d] c] c[w[k rfh[v va v vb v vc v vd v ve v vf v vg]][k rff[v va v vb v vc v vd v ve v vf v vg]]].
