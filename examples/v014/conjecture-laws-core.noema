n:
d sap[va a vb a vc a vd a ve h[a a a] c vf h[a a] c] c[w[g vg a[c[v ve][v va v vb v vg]]][w[g vh a[c[v ve][v va v vc v vh]]][f vi a[f vj a[y[w[c[v ve][v va v vb v vi]][c[v ve][v va v vc v vj]]][z[c[v vf][v vd v vi]][c[v vf][v vd v vj]]]]]]]].
d saq[va a vb a vc a vd h[a] c ve h[a a a] c vf h[a a] c] c[w[g vg a[c[v vd][v vg]]][f vh a[y[c[v vd][v vh]][k sap[v vh v va v vb v vc v ve v vf]]]]].
d sar[va a vb a vc h[a] c vd h[a] c ve h[a a a] c vf h[a a] c] c[w[g vg a[c[v vc][v vg]]][f vh a[y[c[v vc][v vh]][k saq[v va v vb v vh v vd v ve v vf]]]]].
r va[a] c.
r vh[a a a d] c.
r vi[a a d] c.
r eisbd[a d] c.
r eisbe[a a a d] c.
r eisbf[] a.
r eisbg[] a.
r eisbh[a d] c.
r eisbi[a a d] c.
r eisbj[a d] c.
r eisbk[] a.
r eisbl[] a.
r eisbm[a a a d] c.
d eifb[va a vb d] c[w[k va[v va]][k eisbd[v va v vb]]].
d eifc[va a vb a vc d] c[x[k eisbe[v va k eisbf[] v vb v vc]][k eisbe[v va k eisbg[] v vb v vc]]].
d eifd[va a vb a vc a vd d] c[k sar[v vb v vc i[ve a][k eifc[v ve v va v vd]] i[vf a][k eisbj[v vf v vd]] i[vg a vh a vi a][k vh[v vg v vh v vi v vd]] i[vj a vk a][k vi[v vj v vk v vd]]]].
d eife[va a vb a vc d] c[f vd a[y[k eifc[v vd v va v vc]][k eisbi[v vd v vb v vc]]]].
d eiff[va a vb d] c[w[k eisbh[v va v vb]][w[g vc a[k eisbe[v vc k eisbf[] v va v vb]]][w[g vd a[k eisbe[v vd k eisbg[] v va v vb]]][w[g ve a[k eifb[v ve v vb]]][w[f vf a[y[k eifb[v vf v vb]][k eife[v va v vf v vb]]]][f vg a[f vh a[y[w[k eifb[v vg v vb]][k eifb[v vh v vb]]][k eifd[v va v vg v vh v vb]]]]]]]]]].
d eifg[] e[b va[g vb a[k eiff[v vb v va]]]].
d eifh[va a vb d] c[u[g vc a[k eisbm[k eisbk[] v va v vc v vb]]]].
d eifi[] e[b va[w[k eifh[k eisbl[] v va]][k eifh[k eisbf[] v va]]]].
d eifj[] e[b va[w[t[k eifi[]][v va]][t[k eifg[]][v va]]]].
