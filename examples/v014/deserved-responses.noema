n:
d rfo[va a vb a vc h[a] c vd a ve i[h[a] f] vf d vg h[a d] c vh h[a a d] c vi h[a a a i[h[a] f] d] c] c[w[c[v vg][v vb v vf]][w[c[v vh][v va v vb v vf]][w[g vj a[c[v vc][v vj]]][f vk a[y[c[v vc][v vk]][c[v vi][v vb v vk v vd v ve v vf]]]]]]].
d ro5[va a vb i[h[a a a] e] vc i[h[a] e] vd j[h[a i[h[a a a] e] i[h[a] e]] e]] e[b ve[w[t[c[s[v vc]][v va]][v ve]][w[u[e[d[v vd]][n p a b]]][q[v vd][e[n p a b][n p a b]][i[vf c vg h[a i[h[a a a] e] i[h[a] e]] e][w[v vf][t[c[v vg][v va v vb v vc]][v ve]]]]]]]].
d ro6[va i[h[a a a] e] vb i[h[a] e] vc j[h[a i[h[a a a] e] i[h[a] e]] e]] h[a] e[i[vd a][k ro5[v vd v va v vb v vc]]].
d ro7[va h[a] e] h[a] f[i[vb a][j s[c[v va][v vb]]]].
d roa[va h[a] c vb i[h[a] f] vc h[a d] c vd h[a a d] c ve h[a a a i[h[a] f] d] c] h[a a a] e[i[vf a vg a vh a][b vi[k rfo[v vf v vg v va v vh v vb v vi v vc v vd v ve]]]].
