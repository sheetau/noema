n:
d ro[va h[a] c vb h[a] c vc h[a] c] c[w[g vd a[c[v vb][v vd]]][f ve a[y[c[v vb][v ve]][w[c[v va][v ve]][c[v vc][v ve]]]]]].
d rp[va h[a] c vb h[a] c vc h[a a] c] c[w[g vd a[c[v va][v vd]]][w[g ve a[c[v vb][v ve]]][w[f vf a[y[c[v va][v vf]][g vg a[w[c[v vb][v vg]][c[v vc][v vf v vg]]]]]][f vh a[y[c[v vb][v vh]][g vi a[w[c[v va][v vi]][c[v vc][v vi v vh]]]]]]]]].
d rq[va a vb a vc i[h[a] e] vd i[h[a] e] ve d vf h[a a i[h[a] e] i[h[a] e] d] c] c[w[u[e[v vc][v vd]]][c[v vf][v va v vb v vc v vd v ve]]].
d rr[va h[a] c vb d vc h[a d] c vd h[a a d] c] c[w[g ve a[c[v va][v ve]]][g vf a[w[c[v vc][v vf v vb]][f vg a[y[c[v va][v vg]][c[v vd][v vg v vf v vb]]]]]]].
