r ad[b b] b.
d ma[va h[b] b] c[w[e[c[v va][n p a b]][c[v va][n p a b]]][w[e[c[v va][n p b b]][c[v va][n p b b]]][w[e[c[v va][n p c b]][c[v va][n p c b]]][w[k aa[c[v va][n p a b] c[v va][n p b b]]][w[u[k aa[c[v va][n p c b] c[v va][n p a b]]]][u[k aa[c[v va][n p b b] c[v va][n p c b]]]]]]]]].
d mb[va j[h[b] b] vb b vc b] c[w[e[v vb][v vb]][w[e[v vc][v vc]][w[k aa[v vb v vc]][w[k aa[n p a b d[v va]]][w[q[v va][e[n p a b][n p a b]][i[vd c ve h[b] b][w[v vd][k ma[v ve]]]]][c[q[v va][i[vf b][e[v vf][v vb]]][i[vg h[b] c vh h[b] b][i[vi b][w[c[v vg][c[v vh][n p a b]]][e[v vi][c[v vh][n p b b]]]]]]][v vc]]]]]]].
d mc[va j[h[b] b] vb b] c[w[e[v vb][v vb]][w[k aa[n p a b v vb]][q[v va][e[n p a b][n p a b]][i[vc c vd h[b] b][w[v vc][w[k ma[v vd]][k aa[k ab[c[v vd][n p b b] k ac[c[v vd][n p a b]]] v vb]]]]]]]].
d md[va j[h[b] b] vb h[b] b] b[q[v va][n p a b][i[vc b vd h[b] b][k ab[v vc k ad[k ab[c[v vd][n p b b] k ac[c[v vd][n p a b]]] c[v vb][c[v vd][n p c b]]]]]]].
d mg[va b vb b vc b] h[b] b[i[vd b][k ab[k ad[v va k ad[n p b c k ad[k ab[v vd k ac[n p b b]] k ab[v vd k ac[n p c b]]]]] k ab[k ad[v vb k ac[k ad[v vd k ab[v vd k ac[n p c b]]]]] k ad[v vc k ad[n p b c k ad[v vd k ab[v vd k ac[n p b b]]]]]]]]].
d seea[va b vb b] c[w[u[k aa[v va n p a b]]][w[u[k aa[n p b b v va]]][w[k aa[n p a b v vb]][e[k ad[k ab[n p b b k ad[v va v va]] v vb]][n p b b]]]]].
d seeb[va b vb b vc b] b[k ad[v va k ab[k ad[v vb v vb] k ac[k ad[v vc v vc]]]]].
d seec[va b vb b vc b vd b] b[k ad[v va k ab[k ad[v vb v vb] k ac[k ad[k ad[v vc v vd] k ad[v vc v vd]]]]]].
d seed[va b vb b vc b] c[w[k aa[n p a b v va]][w[k aa[n p a b v vb]][w[k aa[n p a b v vc]][e[v vc][k ad[n p e d k ad[v vb k ad[v va k ad[v va v va]]]]]]]]].
d seee[va b vb b vc b vd b] c[w[k aa[n p a b v va]][w[k aa[n p a b v vb]][w[k aa[n p a b v vc]][w[k aa[n p a b v vd]][e[k ad[v vc v vd]][k ad[n p e d k ad[v vb k ad[v va k ad[v va v va]]]]]]]]]].
d seef[va b vb b vc b vd b] b[k ad[v va k ab[k ad[k ad[v vb v vb] v vd] k ac[k ad[n p b d k ad[k ad[v vc v vc] k ad[v vd k ad[v vd v vd]]]]]]]].
d seeg[va b vb b vc b] b[k ad[n p c b k ad[v va k ad[k ad[v vb v vb] v vc]]]].
d seeh[va b vb b vc b vd b ve b vf b] b[k ab[k ad[k ab[v ve k ac[v vd]] k seec[v va v vb v vc v vf]] k ac[k ab[k seef[v va v vb v vc v ve] k ac[k seef[v va v vb v vc v vd]]]]]].
d seei[va b vb b vc b vd b ve b vf b vg b vh b] c[w[u[k aa[v va n p a b]]][w[k aa[n p a b v vf]][w[k aa[n p a b v vg]][w[u[k aa[v vd k ac[v vf]]]][w[u[k aa[v ve v vd]]][w[u[k aa[v vf v ve]]][w[u[k aa[k ab[v vh k ac[k ab[k seef[v va v vb v vc v ve] k ac[k seef[v va v vb v vc v vd]]]]] k ac[k ad[k seeg[v va v vc v vf] k ad[v vg k ab[v ve k ac[v vd]]]]]]]][u[k aa[k ad[k seeg[v va v vc v vf] k ad[v vg k ab[v ve k ac[v vd]]]] k ab[v vh k ac[k ab[k seef[v va v vb v vc v ve] k ac[k seef[v va v vb v vc v vd]]]]]]]]]]]]]]].
d seej[va b vb b vc b vd b ve b vf b vg b vh b] c[w[u[k aa[v va n p a b]]][w[k aa[n p a b v vd]][w[k aa[n p a b v ve]][w[u[k aa[v vf k ac[v vd]]]][w[k aa[v vf v vg]][w[u[k aa[v vd v vg]]][w[u[k aa[v vh v vf]]][w[u[k aa[v vg v vh]]][k aa[k ab[v vg k ac[v vf]] v ve]]]]]]]]]].
d seek[va j[h[b] b] vb b vc b vd b] b[k md[v va i[ve b][k seec[v vb v vc v vd v ve]]]].
d seel[va j[h[b] b] vb b vc b vd b ve b vf b vg b vh b] c[w[u[k aa[v vb n p a b]]][w[k aa[n p a b v vg]][w[k aa[n p a b v vh]][w[u[k aa[v ve k ac[v vg]]]][w[u[k aa[v vg v vf]]][w[k mb[v va v ve v vf]][k mc[v va v vh]]]]]]]].
