r aa[b b] c.
r ab[b b] b.
r ac[b] b.
r ad[b b] b.
d sra[va b vb b vc b] c[w[k aa[n p a b v va]][w[k aa[k ad[v vb v vb] k ad[v va v va]]][w[k aa[n p a b v vc]][e[k ad[k ad[v vc v vc] k ab[k ad[v va v va] k ac[k ad[v vb v vb]]]]][k ad[v va v va]]]]]].
d semp[va b vb b vc b vd b ve b vf b vg b vh b vi b vj b vk b] c[w[k sra[v va v vb v vc]][w[u[e[k ab[k ad[v va v va] k ac[k ad[v vb v ve]]]][n p a b]]][w[e[k ad[k ab[k ad[v va v va] k ac[k ad[v vb v ve]]] v vi]][k ad[k ad[v va v va] k ab[v ve k ac[v vb]]]]][w[e[k ad[k ad[v vc k ab[k ad[v va v va] k ac[k ad[v vb v ve]]]] v vj]][k ad[k ad[v va v va] v vf]]][w[e[k ad[k ad[v vc k ab[k ad[v va v va] k ac[k ad[v vb v ve]]]] v vk]][k ad[k ad[v va v va] v vg]]][e[k ad[k ad[v va v va] v vh]][k ad[k ad[v vc k ab[k ad[v va v va] k ac[k ad[v vb v ve]]]] v vd]]]]]]]].
d senc[va b vb b vc b vd b ve b vf b vg b vh b vi b vj b vk b vl b vm b vn b vo b vp b vq b] c[w[k sra[v va v vb v vc]][w[k aa[n p a b k ab[k ad[v va v va] k ac[k ad[v vb v vd]]]]][w[e[v vl][k ab[v vg k ad[v vd v vj]]]][w[e[v vm][k ab[v vh k ad[v ve v vj]]]][w[e[v vn][k ab[v vi k ad[v vf v vj]]]][w[e[v vo][k ad[v vc k ab[v vl k ac[k ad[v vb v vj]]]]]][w[e[v vp][v vm]][w[e[v vq][v vn]][e[k ad[k ad[v va v va] v vk]][k ad[v vc k ab[k ad[k ad[v va v va] v vj] k ac[k ad[v vb v vl]]]]]]]]]]]]]].
d send[va b vb b vc b vd b ve b vf b vg b vh b vi b] c[w[k sra[v va v vb v vc]][w[k aa[n p a b k ab[k ad[v va v va] k ac[k ad[v vb v vd]]]]][w[e[k ad[k ad[v vc k ab[k ad[v va v va] k ac[k ad[v vb v vd]]]] v vg]][k ad[v va v va]]][w[e[k ad[k ab[k ad[v va v va] k ac[k ad[v vb v vd]]] v vh]][k ad[v vb v ve]]][e[k ad[k ab[k ad[v va v va] k ac[k ad[v vb v vd]]] v vi]][k ad[v vb v vf]]]]]]].
d sene[va b vb b vc b vd b ve b vf b vg b vh b vi b vj b vk b vl b vm b vn b vo b vp b vq b vr b] c[w[k semp[v va v vb v vc v vd v ve v vf v vg v vh v vi v vj v vk]][w[k send[v va v vb v vc v ve v vf v vg v vl v vm v vn]][w[k aa[n p a b v vo]][w[k aa[n p a b v vp]][w[e[v vp][k ad[v vl v vo]]][w[e[v vq][k ad[v vd v vo]]][e[v vr][k ad[v vh v vp]]]]]]]]].
