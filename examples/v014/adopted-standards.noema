n:
d rfo[va a vb a vc h[a] c vd a ve i[h[a] f] vf d vg h[a d] c vh h[a a d] c vi h[a a a i[h[a] f] d] c] c[w[c[v vg][v vb v vf]][w[c[v vh][v va v vb v vf]][w[g vj a[c[v vc][v vj]]][f vk a[y[c[v vc][v vk]][c[v vi][v vb v vk v vd v ve v vf]]]]]]].
d rfu[va a vb i[h[a] f] vc j[h[a i[h[a] f]] e]] e[b vd[q[v vc][e[n p a b][n p a b]][i[ve c vf h[a i[h[a] f]] e][w[v ve][t[c[v vf][v va v vb]][v vd]]]]]].
d rfv[va a vb a vc a vd h[a] c ve h[a] c vf a vg i[h[a] f] vh j[h[a i[h[a] f]] e] vi h[a a a d] c vj h[a a j[h[a i[h[a] f]] e] d] c vk h[a a a d] c vl h[a a d] c vm h[a d] c vn h[a a d] c vo h[a a a i[h[a] f] d] c] h[a a] e[i[vp a vq a][b vr[w[w[c[v vi][v vp v va v vb v vr]][w[c[v vj][v va v vc v vh v vr]][w[c[v vk][v vp v vq v vb v vr]][c[v vl][v vp v vb v vr]]]]][w[k rfo[v vp v vq i[vs a][x[c[v vd][v vs]][c[v ve][v vs]]] v vf v vg v vr v vm v vn v vo]][t[k rfu[v vf v vg v vh]][v vr]]]]]].
d rfw[va a vb a vc a vd h[a] c ve h[a] c vf a vg i[h[a] f] vh i[j[h[a i[h[a] f]] e]] vi h[a a a d] c vj h[a a i[j[h[a i[h[a] f]] e]] d] c vk h[a a a d] c vl h[a a d] c vm h[a d] c vn h[a a d] c vo h[a a a i[h[a] f] d] c] h[a a] e[k rfv[v va v vb v vc v vd v ve v vf v vg s[v vh] v vi i[vp a vq a vr j[h[a i[h[a] f]] e] vs d][c[v vj][v vp v vq v vh v vs]] v vk v vl v vm v vn v vo]].
