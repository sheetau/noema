n:
d rfo[va a vb a vc h[a] c vd a ve i[h[a] f] vf d vg h[a d] c vh h[a a d] c vi h[a a a i[h[a] f] d] c] c[w[c[v vg][v vb v vf]][w[c[v vh][v va v vb v vf]][w[g vj a[c[v vc][v vj]]][f vk a[y[c[v vc][v vk]][c[v vi][v vb v vk v vd v ve v vf]]]]]]].
d rnc[va a vb a vc h[a] c vd i[h[a] f] ve d vf h[a d] c vg h[a a d] c vh h[a a a i[h[a] f] d] c] c[k rfo[v va v vb v vc v va v vd v ve v vf v vg v vh]].
d rnh[va a vb a vc a vd a ve d vf h[a d] c vg h[a a d] c vh h[a a a d] c] c[w[c[v vf][v vb v ve]][w[c[v vg][v va v vb v ve]][c[v vh][v vb v vc v vd v ve]]]].
d rni[va a vb h[a] c vc h[a d] c vd h[a a d] c ve h[a a a d] c] h[a] e[i[vf a][b vg[w[g vh a[c[v vb][v vh]]][f vi a[y[c[v vb][v vi]][u[g vj a[k rnh[v vi v vj v va v vf v vg v vc v vd v ve]]]]]]]]].
d rnj[va a vb h[a] c vc h[a d] c vd h[a a d] c ve h[a a a d] c] h[a] f[i[vf a][j m[c[k rni[v va v vb v vc v vd v ve]][v vf]]]].
