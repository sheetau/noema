d ta[va h[d] c vb h[d d] c] c[w[g vc d[c[v va][v vc]]][w[f vd d[y[c[v va][v vd]][u[c[v vb][v vd v vd]]]]][w[f ve d[f vf d[y[w[c[v va][v ve]][w[c[v va][v vf]][u[e[v ve][v vf]]]]][x[c[v vb][v ve v vf]][c[v vb][v vf v ve]]]]]][f vg d[f vh d[f vi d[y[w[c[v va][v vg]][w[c[v va][v vh]][w[c[v va][v vi]][w[c[v vb][v vg v vh]][c[v vb][v vh v vi]]]]]][c[v vb][v vg v vi]]]]]]]]].
d rby[va h[d] c vb h[d d] c vc d] h[d] c[i[vd d][w[c[v va][v vd]][x[e[v vd][v vc]][c[v vb][v vc v vd]]]]].
d rca[va h[d] c vb h[d d] c vc d vd h[d] c] c[w[k ta[v va v vb]][w[c[v va][v vc]][f ve d[y[c[k rby[v va v vb v vc]][v ve]][c[v vd][v ve]]]]]].
d rkh[va h[d] c vb h[d d] c vc d vd e ve e vf d] c[w[k ta[v va v vb]][w[c[v va][v vc]][w[c[v va][v vf]][w[x[e[v vc][v vf]][c[v vb][v vc v vf]]][w[t[v ve][v vf]][f vg d[y[w[c[v va][v vg]][w[x[e[v vc][v vg]][c[v vb][v vc v vg]]][c[v vb][v vg v vf]]]][w[t[v vd][v vg]][u[t[v ve][v vg]]]]]]]]]]].
d rki[va h[d] c vb h[d d] c vc d vd e ve e] c[g vf d[k rkh[v va v vb v vc v vd v ve v vf]]].
d rkj[va h[d] c vb h[d d] c vc d vd e ve e] c[x[k rki[v va v vb v vc v vd v ve]][k rca[v va v vb v vc i[vf d][w[t[v vd][v vf]][u[t[v ve][v vf]]]]]]].
