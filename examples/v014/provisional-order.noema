d rkl[va a vb a vc d vd h[a d] c ve h[a a d] c vf h[a a a d] c vg h[a a a d] c] c[w[c[v vd][v vb v vc]][f vh a[y[c[v ve][v va v vh v vc]][w[g vi a[c[v vf][v vh v vi v vb v vc]]][f vj a[y[c[v vf][v vh v vj v vb v vc]][c[v vg][v vh v vj v vb v vc]]]]]]]].
