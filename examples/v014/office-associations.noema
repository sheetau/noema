d ris[va a vb a vc a vd i[h[a] e] ve d vf h[a] c vg h[a a d] c vh h[a a a d] c vi h[a a i[h[a] e] d] c] c[w[c[v vf][v va]][w[c[v vg][v va v vc v ve]][w[c[v vh][v va v vb v vc v ve]][c[v vi][v vb v vc v vd v ve]]]]].
d rit[va a vb i[h[a] e] vc d vd h[a a d] c ve h[a] c vf h[a a d] c vg h[a a a d] c vh h[a a i[h[a] e] d] c] c[w[k rir[v va v vc v vd v ve]][f vi a[y[c[v vd][v va v vi v vc]][g vj a[g vk a[k ris[v vi v vj v vk v vb v vc v ve v vf v vg v vh]]]]]]].
