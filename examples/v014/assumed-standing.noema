d rfp[va a vb a vc j[h[a a] e]] e[b vd[q[v vc][u[e[n p a b][n p a b]]][i[ve c vf h[a a] e][x[v ve][u[t[c[v vf][v va v vb]][v vd]]]]]]].
d rfq[va a vb a vc a vd j[h[a a] e] ve h[a a a d] c] e[b vf[w[c[v ve][v vb v va v vc v vf]][t[k rfp[v vb v vc v vd]][v vf]]]].
d rfr[va a vb a vc j[h[a a] e] vd h[a a a d] c] h[a] e[i[ve a][k rfq[v ve v va v vb v vc v vd]]].
