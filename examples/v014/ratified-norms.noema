n:
d rhp[va a vb a vc a vd i[h[j[a]] e] ve j[a] vf d vg h[a a a i[h[j[a]] e] j[a] c d] c vh h[a a a i[h[j[a]] e] j[a] c d] c] c[w[u[c[v vg][v va v vb v vc v vd v ve e[n p a b][n p a b] v vf]]][w[u[c[v vg][v va v vb v vc v vd v ve u[e[n p a b][n p a b]] v vf]]][w[u[c[v vh][v va v vb v vc v vd v ve e[n p a b][n p a b] v vf]]][u[c[v vh][v va v vb v vc v vd v ve u[e[n p a b][n p a b]] v vf]]]]]].
d rhq[va a vb d vc h[a a a i[h[j[a]] e] j[a] c d] c vd h[a a a i[h[j[a]] e] j[a] c d] c] c[f ve a[f vf a[f vg i[h[j[a]] e][f vh j[a][k rhp[v va v ve v vf v vg v vh v vb v vc v vd]]]]]].
d rhr[va a vb d vc h[a a a i[h[j[a]] e] j[a] c d] c vd h[a a a i[h[j[a]] e] j[a] c d] c ve h[a] c vf h[a] a vg h[a] a vh h[a] i[h[j[a]] e] vi h[a] j[a]] c[f vj a[y[c[v ve][v vj]][k rhp[v va c[v vf][v vj] c[v vg][v vj] c[v vh][v vj] c[v vi][v vj] v vb v vc v vd]]]].
d rhs[va a vb d vc h[a a a i[h[j[a]] e] j[a] c d] c vd h[a a a i[h[j[a]] e] j[a] c d] c ve h[a] c vf h[a] a vg h[a] a vh h[a] i[h[j[a]] e] vi h[a] j[a]] c[f vj a[f vk a[f vl i[h[j[a]] e][f vm j[a][y[u[k rhp[v va v vj v vk v vl v vm v vb v vc v vd]]][g vn a[w[c[v ve][v vn]][w[e[v vj][c[v vf][v vn]]][w[e[v vk][c[v vg][v vn]]][w[e[v vl][c[v vh][v vn]]][e[v vm][c[v vi][v vn]]]]]]]]]]]]].
d rht[va a vb d vc h[a a a i[h[j[a]] e] j[a] c d] c vd h[a a a i[h[j[a]] e] j[a] c d] c ve h[a] c vf h[a] a vg h[a] a vh h[a] i[h[j[a]] e] vi h[a] j[a]] c[w[k rhr[v va v vb v vc v vd v ve v vf v vg v vh v vi]][k rhs[v va v vb v vc v vd v ve v vf v vg v vh v vi]]].
d rhu[va a vb d vc h[a] c vd h[a a d] c] c[w[g ve a[c[v vc][v ve]]][f vf a[y[c[v vc][v vf]][c[v vd][v vf v va v vb]]]]].
d rhv[va a vb h[d] c vc h[a] c vd h[a a d] c ve h[a d] c] c[f vf d[y[c[v vb][v vf]][y[k rhu[v va v vf v vc v vd]][c[v ve][v va v vf]]]]].
d rhw[va a vb h[d] c vc h[a] c vd h[a a d] c] c[g ve d[w[c[v vb][v ve]][k rhu[v va v ve v vc v vd]]]].
