d rcm[va j[a] vb h[a] c] c[w[k he[]][w[k hi[v va v vb]][w[k hc[n p a b d[v va]]][f vc a[z[c[v vb][v vc]][k hg[v va v vc]]]]]]].
d rup[va j[a] vb h[a] c vc h[b] c] c[w[k rcm[v va v vb]][c[v vc][d[v va]]]].
d ruq[va a vb a vc j[a] vd d ve h[a a d] c vf h[a a a a d] e vg h[a a a d] c vh h[a a a d d] c vi h[a a a d d] c vj a] c[w[k rcm[v vc i[vk a][c[v ve][v vb v vk v vd]]]][w[c[v vg][v va v vb v vj v vd]][w[w[g vl d[c[v vi][v va v vb v vj v vd v vl]]][f vm d[y[c[v vi][v va v vb v vj v vd v vm]][c[v vh][v va v vb v vj v vd v vm]]]]][f vn d[y[c[v vi][v va v vb v vj v vd v vn]][q[v vc][e[n p a b][n p a b]][i[vo c vp a][w[v vo][t[c[v vf][v va v vb v vp v vj v vd]][v vn]]]]]]]]]].
d rur[va a vb a vc j[a] vd d ve h[a a d] c vf h[a a a a d] e vg h[a a a d] c vh h[a a a d d] c vi h[a a a d d] c vj a vk e] c[w[k ruq[v va v vb v vc v vd v ve v vf v vg v vh v vi v vj]][f vl d[y[c[v vi][v va v vb v vj v vd v vl]][t[v vk][v vl]]]]].
d rus[va a vb a vc j[a] vd d ve h[a a d] c vf h[a a a a d] e vg h[a a a d] c vh h[a a a d d] c vi h[a a a d d] c vj e] c[g vk a[k rur[v va v vb v vc v vd v ve v vf v vg v vh v vi v vk v vj]]].
d rut[va a vb a vc j[a] vd d ve h[a a d] c vf h[a a a a d] e vg h[a a a d] c vh h[a a a d d] c vi h[a a a d d] c] c[w[g vj a[c[v vg][v va v vb v vj v vd]]][f vk a[y[c[v vg][v va v vb v vk v vd]][k ruq[v va v vb v vc v vd v ve v vf v vg v vh v vi v vk]]]]].
d ruu[va a vb a vc j[a] vd d ve h[a a d] c vf h[a a a a d] e vg h[a a a d] c vh h[a a a d d] c vi h[a a a d d] c vj e vk h[b] c] c[w[k rup[v vc i[vl a][c[v ve][v vb v vl v vd]] v vk]][w[k rut[v va v vb v vc v vd v ve v vf v vg v vh v vi]][k rus[v va v vb v vc v vd v ve v vf v vg v vh v vi v vj]]]].
