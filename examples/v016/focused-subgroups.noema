d rqtl[va i b[h[i[h[a d] c]] e] vb j[i[h[a d] c]]] j[i b[e]][q[v vb][l[i b[e]][]][i[vc j[i b[e]] vd i[h[a d] c]][m[v vc][l[i b[e]][k rqtk[v va v vd]]]]]].
