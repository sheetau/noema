p:
d rcd[va h[a] c vb h[a a] c] c[w[g vc a[c[v va][v vc]]][w[f vd a[y[c[v va][v vd]][c[v vb][v vd v vd]]]][w[f ve a[f vf a[y[w[c[v va][v ve]][c[v va][v vf]]][x[c[v vb][v ve v vf]][c[v vb][v vf v ve]]]]]][f vg a[f vh a[f vi a[y[w[c[v va][v vg]][w[c[v va][v vh]][w[c[v va][v vi]][w[c[v vb][v vg v vh]][c[v vb][v vh v vi]]]]]][c[v vb][v vg v vi]]]]]]]]].
d rce[va a vb h[a] c vc h[a a] c] c[w[k rcd[v vb v vc]][w[c[v vb][v va]][f vd a[y[c[v vb][v vd]][c[v vc][v va v vd]]]]]].
d r2ho[va a vb a vc i[h[a a] e] vd h[a] c ve d vf h[a i[h[a a] e] a a a a d] c] c[w[f vg a[y[c[v vd][v vg]][c[v vf][v va v vc v vb v vg v vb v vg v ve]]]][f vh a[f vi a[f vj a[y[w[c[v vd][v vh]][w[c[v vd][v vi]][w[c[v vd][v vj]][w[c[v vf][v va v vc v vb v vh v vb v vi v ve]][c[v vf][v va v vc v vb v vi v vb v vj v ve]]]]]][c[v vf][v va v vc v vb v vh v vb v vj v ve]]]]]]].
d r2hp[va a vb a vc i[h[a a] e] vd a ve a vf d vg h[a i[h[a a] e] a a a a d] c] c[w[c[v vg][v va v vc v vb v ve v vb v vd v vf]][u[c[v vg][v va v vc v vb v vd v vb v ve v vf]]]].
d r2hq[va a vb a vc i[h[a a] e] vd a ve h[a] c vf h[a a] c vg d vh h[a i[h[a a] e] a a a a d] c] c[w[k rce[v vd v ve v vf]][w[g vi a[w[c[v ve][v vi]][w[c[v vf][v vd v vi]][u[c[v vf][v vi v vd]]]]]][w[k r2ho[v va v vb v vc i[vj a][x[e[v vj][v vd]][w[c[v ve][v vj]][w[c[v vf][v vd v vj]][u[c[v vf][v vj v vd]]]]]] v vg v vh]][f vk a[y[w[c[v ve][v vk]][w[c[v vf][v vd v vk]][u[c[v vf][v vk v vd]]]]][k r2hp[v va v vb v vc v vd v vk v vg v vh]]]]]]].
