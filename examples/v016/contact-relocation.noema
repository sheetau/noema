d ta[va h[d] c vb h[d d] c] c[w[g vc d[c[v va][v vc]]][w[f vd d[y[c[v va][v vd]][u[c[v vb][v vd v vd]]]]][w[f ve d[f vf d[y[w[c[v va][v ve]][w[c[v va][v vf]][u[e[v ve][v vf]]]]][x[c[v vb][v ve v vf]][c[v vb][v vf v ve]]]]]][f vg d[f vh d[f vi d[y[w[c[v va][v vg]][w[c[v va][v vh]][w[c[v va][v vi]][w[c[v vb][v vg v vh]][c[v vb][v vh v vi]]]]]][c[v vb][v vg v vi]]]]]]]]].
d tb[va h[d] c vb h[d] c vc h[d d] c] c[w[k ta[v va v vc]][w[g vd d[c[v vb][v vd]]][w[f ve d[y[c[v vb][v ve]][c[v va][v ve]]]][f vf d[f vg d[f vh d[y[w[c[v vb][v vf]][w[c[v vb][v vh]][w[c[v va][v vg]][w[c[v vc][v vf v vg]][c[v vc][v vg v vh]]]]]][c[v vb][v vg]]]]]]]]].
d rqzb[va a vb a vc a vd d ve d vf h[d] c vg h[d] c vh h[d d] c vi h[a d] a vj h[a a d] c] c[w[u[e[v vb][v vc]]][w[k tb[v vf v vg v vh]][w[c[v vg][v vd]][w[c[v vg][v ve]][w[c[v vh][v vd v ve]][w[e[c[v vi][v va v vd]][v vb]][w[e[c[v vi][v va v ve]][v vc]][w[c[v vj][v va v vb v vd]][w[c[v vj][v va v vc v ve]][w[f vk d[y[c[v vg][v vk]][w[x[e[v vk][v vd]][c[v vh][v vd v vk]]][x[e[v vk][v ve]][c[v vh][v vk v ve]]]]]][w[g vl d[w[c[v vg][v vl]][w[c[v vh][v vd v vl]][c[v vh][v vl v ve]]]]][f vm d[y[w[c[v vg][v vm]][w[c[v vh][v vd v vm]][c[v vh][v vm v ve]]]][f vn a[u[c[v vj][v va v vn v vm]]]]]]]]]]]]]]]]].
d rqzc[va a vb a vc h[d] c vd h[a a d] c ve h[a a d] c] c[f vf d[y[c[v vc][v vf]][g vg a[g vh a[w[u[e[v vg][v vb]]][w[c[v vd][v vg v va v vf]][c[v ve][v vg v vh v vf]]]]]]]].
