p:
d rym[va a vb a vc h[d] c vd h[a a d] c ve h[a a d] a vf h[a a d] a vg h[a a d] c vh h[a a d a] c] c[w[g vi d[c[v vc][v vi]]][f vj d[y[c[v vc][v vj]][c[v vd][v va v vb v vj]]]]].
d ryn[va a vb a vc h[d] c vd h[a a d] c ve h[a a d] a vf h[a a d] a vg h[a a d] c vh h[a a d a] c] c[w[k rym[v va v vb v vc v vd v ve v vf v vg v vh]][f vi d[f vj d[y[w[c[v vc][v vi]][w[c[v vc][v vj]][e[c[v ve][v va v vb v vi]][c[v ve][v va v vb v vj]]]]][e[c[v vf][v va v vb v vi]][c[v vf][v va v vb v vj]]]]]]].
d ryo[va a vb a vc h[d] c vd h[a a d] c ve h[a a d] a vf h[a a d] a vg h[a a d] c vh h[a a d a] c] c[w[k rym[v va v vb v vc v vd v ve v vf v vg v vh]][g vi d[g vj d[w[w[c[v vc][v vi]][w[c[v vc][v vj]][e[c[v ve][v va v vb v vi]][c[v ve][v va v vb v vj]]]]][w[u[e[c[v vf][v va v vb v vi]][c[v vf][v va v vb v vj]]]][w[c[v vg][v va v vb v vi]][w[c[v vg][v va v vb v vj]][g vk a[u[e[c[v vh][v va v vb v vi v vk]][c[v vh][v va v vb v vj v vk]]]]]]]]]]]].
