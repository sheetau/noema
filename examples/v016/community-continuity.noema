d rks[va j[a] vb h[a h[a] c] c vc a vd h[h[a] c] c ve a] c[w[w[k rz[v va v vc]][w[k rz[v va v ve]][u[e[v vc][v ve]]]]][w[k rw[v va v vb i[vf a][x[e[v vf][v vc]][e[v vf][v ve]]] i[vg a][x[w[e[v vg][v vc]][u[e[n p a b][n p a b]]]][w[e[v vg][v ve]][u[e[n p a b][n p a b]]]]] v vd]][w[k rw[v va v vb i[vh a][x[e[v vh][v vc]][e[v vh][v ve]]] i[vi a][x[w[e[v vi][v vc]][u[e[n p a b][n p a b]]]][w[e[v vi][v ve]][e[n p a b][n p a b]]]] i[vj h[a] c][u[c[v vd][v vj]]]]][w[k rw[v va v vb i[vk a][x[e[v vk][v vc]][e[v vk][v ve]]] i[vl a][x[w[e[v vl][v vc]][e[n p a b][n p a b]]][w[e[v vl][v ve]][u[e[n p a b][n p a b]]]]] v vd]][k rw[v va v vb i[vm a][x[e[v vm][v vc]][e[v vm][v ve]]] i[vn a][x[w[e[v vn][v vc]][e[n p a b][n p a b]]][w[e[v vn][v ve]][e[n p a b][n p a b]]]] v vd]]]]]].
d rku[va j[a] vb h[a h[a] c] c vc a vd h[h[a] c] c ve a vf h[h[a] c] d vg e vh e vi e] c[w[w[k rz[v va v vc]][w[k rz[v va v ve]][u[e[v vc][v ve]]]]][w[k rw[v va v vb i[vj a][x[e[v vj][v vc]][e[v vj][v ve]]] i[vk a][x[w[e[v vk][v vc]][u[e[n p a b][n p a b]]]][w[e[v vk][v ve]][u[e[n p a b][n p a b]]]]] i[vl h[a] c][w[w[z[t[v vg][c[v vf][v vl]]][c[v vl][v vc]]][z[t[v vh][c[v vf][v vl]]][c[v vd][v vl]]]][z[t[v vi][c[v vf][v vl]]][c[v vl][v ve]]]]]][w[k rw[v va v vb i[vm a][x[e[v vm][v vc]][e[v vm][v ve]]] i[vn a][x[w[e[v vn][v vc]][u[e[n p a b][n p a b]]]][w[e[v vn][v ve]][e[n p a b][n p a b]]]] i[vo h[a] c][w[w[z[t[v vg][c[v vf][v vo]]][c[v vo][v vc]]][z[t[v vh][c[v vf][v vo]]][c[v vd][v vo]]]][z[t[v vi][c[v vf][v vo]]][c[v vo][v ve]]]]]][w[k rw[v va v vb i[vp a][x[e[v vp][v vc]][e[v vp][v ve]]] i[vq a][x[w[e[v vq][v vc]][e[n p a b][n p a b]]][w[e[v vq][v ve]][u[e[n p a b][n p a b]]]]] i[vr h[a] c][w[w[z[t[v vg][c[v vf][v vr]]][c[v vr][v vc]]][z[t[v vh][c[v vf][v vr]]][c[v vd][v vr]]]][z[t[v vi][c[v vf][v vr]]][c[v vr][v ve]]]]]][k rw[v va v vb i[vs a][x[e[v vs][v vc]][e[v vs][v ve]]] i[vt a][x[w[e[v vt][v vc]][e[n p a b][n p a b]]][w[e[v vt][v ve]][e[n p a b][n p a b]]]] i[vu h[a] c][w[w[z[t[v vg][c[v vf][v vu]]][c[v vu][v vc]]][z[t[v vh][c[v vf][v vu]]][c[v vd][v vu]]]][z[t[v vi][c[v vf][v vu]]][c[v vu][v ve]]]]]]]]]].
