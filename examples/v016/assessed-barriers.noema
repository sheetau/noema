p:
d xa[va a vb a vc d vd h[a a d d] c ve h[a a d d] c] c[w[g vf d[c[v ve][v va v vb v vc v vf]]][f vg d[y[c[v ve][v va v vb v vc v vg]][c[v vd][v va v vb v vc v vg]]]]].
d xd[va a vb e vc d vd h[a a d] c ve h[a a d d] c vf h[a a d d] c] c[g vg a[w[c[v vd][v va v vg v vc]][w[k xa[v va v vg v vc v ve v vf]][f vh d[y[c[v vf][v va v vg v vc v vh]][t[v vb][v vh]]]]]]].
d xe[va a vb d vc h[a a d] c vd h[a a d d] c ve h[a a d d] c] c[f vf a[y[c[v vc][v va v vf v vb]][k xa[v va v vf v vb v vd v ve]]]].
d xg[va a vb e vc d vd h[a a d] c ve h[a a d d] c vf h[a a d d] c] c[w[k xe[v va v vc v vd v ve v vf]][u[k xd[v va v vb v vc v vd v ve v vf]]]].
d rz[va j[a] vb a] c[q[v va][u[e[n p a b][n p a b]]][i[vc c vd a][x[v vc][e[v vd][v vb]]]]].
d rs[va j[a]] j[h[a] c][q[v va][l[h[a] c][i[vb a][u[e[n p a b][n p a b]]]]][i[vc j[h[a] c] vd a][q[v vc][l[h[a] c][]][i[ve j[h[a] c] vf h[a] c][m[v ve][l[h[a] c][i[vg a][x[e[v vg][v vd]][c[v vf][v vg]]] i[vh a][w[u[e[v vh][v vd]]][c[v vf][v vh]]]]]]]]]].
d rt[va j[a]] c[f vb a[c[q[v va][i[vc c][e[n p a b][n p a b]]][i[vd h[c] c ve a][i[vf c][w[u[w[v vf][e[v ve][v vb]]]][c[v vd][x[v vf][e[v ve][v vb]]]]]]]][u[e[n p a b][n p a b]]]]].
d ru[va j[a] vb h[a h[a] c] c vc h[a] c vd h[a] c ve h[a] c] c[w[k rt[v va]][w[f vf a[y[u[k rz[v va v vf]]][u[c[v ve][v vf]]]]][q[v va][e[n p a b][n p a b]][i[vg c vh a][w[v vg][w[y[c[v vc][v vh]][z[c[v ve][v vh]][c[v vd][v vh]]]][y[u[c[v vc][v vh]]][z[c[v ve][v vh]][c[v vb][v vh v ve]]]]]]]]]].
d rv[va j[a] vb h[a h[a] c] c vc h[a] c vd h[a] c ve h[h[a] c] c] c[q[k rs[v va]][u[e[n p a b][n p a b]]][i[vf c vg h[a] c][x[v vf][w[k ru[v va v vb v vc v vd v vg]][c[v ve][v vg]]]]]].
d rw[va j[a] vb h[a h[a] c] c vc h[a] c vd h[a] c ve h[h[a] c] c] c[w[k rv[v va v vb v vc v vd i[vf h[a] c][e[n p a b][n p a b]]]][q[k rs[v va]][e[n p a b][n p a b]][i[vg c vh h[a] c][w[v vg][y[k ru[v va v vb v vc v vd v vh]][c[v ve][v vh]]]]]]].
d rww[va a vb e vc j[a] vd h[a h[a] c] c ve a vf h[h[a] c] d vg h[a a d] c vh h[a a d d] c vi h[a a d d] c] c[w[k rz[v vc v ve]][w[k rv[v vc v vd i[vj a][e[v vj][v ve]] i[vk a][u[e[n p a b][n p a b]]] i[vl h[a] c][k xd[v va v vb c[v vf][v vl] v vg v vh v vi]]]][k rw[v vc v vd i[vm a][e[v vm][v ve]] i[vn a][e[n p a b][n p a b]] i[vo h[a] c][k xg[v va v vb c[v vf][v vo] v vg v vh v vi]]]]]].
d rwx[va a vb e vc j[a] vd h[a h[a] c] c ve a vf h[h[a] c] d vg h[a a d] c vh h[a a d d] c vi h[a a d d] c vj d vk h[a] c] c[w[k rww[v va v vb v vc v vd v ve v vf v vg v vh v vi]][w[k ru[v vc v vd i[vl a][u[e[n p a b][n p a b]]] i[vm a][u[e[n p a b][n p a b]]] v vk]][w[c[v vk][v ve]][w[e[c[v vf][v vk]][v vj]][k xg[v va v vb v vj v vg v vh v vi]]]]]].
