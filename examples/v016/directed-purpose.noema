d rqys[va h[a] c vb a vc d vd h[a d] c ve h[a a d] c] c[w[c[v vd][v vb v vc]][w[g vf a[c[v va][v vf]]][f vg a[y[c[v va][v vg]][c[v ve][v vg v vb v vc]]]]]].
d rqyt[va h[a] c vb a vc i[e] vd d ve h[a a i[e] d] c] h[a] c[i[vf a][w[c[v va][v vf]][c[v ve][v vf v vb v vc v vd]]]].
d rqyu[va h[a] c vb a vc i[e] vd d ve h[a d] c vf h[a a d] c vg h[a a i[e] d] c vh h[a a a i[e] d] c] c[w[k rqys[v va v vb v vd v ve v vf]][w[g vi a[c[k rqyt[v va v vb v vc v vd v vg]][v vi]]][f vj a[y[c[v va][v vj]][g vk a[w[c[k rqyt[v va v vb v vc v vd v vg]][v vk]][x[e[v vj][v vk]][c[v vh][v vk v vj v vb v vc v vd]]]]]]]]].
