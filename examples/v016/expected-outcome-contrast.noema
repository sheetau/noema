p:
d rta[va j[i b[e]] vb a vc d vd h[a i b[e] i b[e] d] c] c[w[q[v va][e[n p a b][n p a b]][i[ve c vf i b[e]][w[v ve][u[c[v vd][v vb v vf v vf v vc]]]]]][q[v va][e[n p a b][n p a b]][i[vg c vh i b[e]][w[v vg][q[v va][e[n p a b][n p a b]][i[vi c vj i b[e]][w[v vi][q[v va][e[n p a b][n p a b]][i[vk c vl i b[e]][w[v vk][y[w[c[v vd][v vb v vh v vj v vc]][c[v vd][v vb v vj v vl v vc]]][c[v vd][v vb v vh v vl v vc]]]]]]]]]]]]].
d rtb[va i b[e] vb j[i b[e]] vc a vd d ve h[a i b[e] i b[e] d] c] c[w[u[e[d[v vb]][n p a b]]][w[k rta[m[l[i b[e]][v va]][v vb] v vc v vd v ve]][q[v vb][e[n p a b][n p a b]][i[vf c vg i b[e]][w[v vf][w[u[e[v va][v vg]]][c[v ve][v vc v va v vg v vd]]]]]]]].
d rqtq[va j[i b[e]] vb a vc d vd h[a i b[e] i b[e] d] c] c[w[q[v va][e[n p a b][n p a b]][i[ve c vf i b[e]][w[v ve][c[v vd][v vb v vf v vf v vc]]]]][q[v va][e[n p a b][n p a b]][i[vg c vh i b[e]][w[v vg][q[v va][e[n p a b][n p a b]][i[vi c vj i b[e]][w[v vi][q[v va][e[n p a b][n p a b]][i[vk c vl i b[e]][w[v vk][y[w[c[v vd][v vb v vh v vj v vc]][c[v vd][v vb v vj v vl v vc]]][c[v vd][v vb v vh v vl v vc]]]]]]]]]]]]].
d rqtr[va a vb i b[e] vc i b[e] vd d ve h[a i b[e] i b[e] d] c] c[w[c[v ve][v va v vc v vb v vd]][u[c[v ve][v va v vb v vc v vd]]]].
d rqts[va i b[e] vb j[i b[e]] vc a vd d ve h[a i b[e] i b[e] d] c] e[b vf[w[k rqtq[m[l[i b[e]][v va]][v vb] v vc v vd v ve]][k rtb[v va v vb v vc v vd i[vg a vh i b[e] vi i b[e] vj d][k rqtr[v vg v vh v vi v vj v ve]]]]]].
d rqvq[va i b[e] vb i b[e]] i b[e][o a[r b[i[va e vb e][b vc[w[t[v va][v vc]][t[v vb][v vc]]]]]][v va v vb]].
d rqvr[va i b[e] vb i b[e]] i b[e][o a[r b[i[va e vb e][b vc[w[t[v va][v vc]][u[t[v vb][v vc]]]]]]][v va v vb]].
d rqvs[va i b[e] vb i b[e] vc a vd d ve h[a i b[e] i b[e] d] c] e[k rqts[k rqvq[v va v vb] l[i b[e]][k rqvr[v va v vb]] v vc v vd v ve]].
d rqvt[va a vb a vc d vd h[a a d] c] c[w[u[e[v va][v vb]]][w[c[v vd][v va v vb v vc]][u[c[v vd][v vb v va v vc]]]]].
