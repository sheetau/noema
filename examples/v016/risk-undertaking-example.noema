d rwk[va a vb a vc a vd i c[h[a a] e] ve d vf h[a a d] c vg h[a a a a i c[h[a a] e] c d] c vh h[a a a a i c[h[a a] e] c d] c] c[f vi a[y[c[v vf][v vb v vi v ve]][u[k rwj[v va v vb v vc v vi v vd v ve v vg v vh]]]]].
