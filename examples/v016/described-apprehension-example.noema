p:
d rvm[va a vb i[h[a] e] vc d vd h[a a d] c ve h[a i[h[a] e] d] c vf h[a d] c vg h[a d d] c vh h[a d] c] c[g vi a[w[c[v vd][v va v vi v vc]][w[c[v ve][v vi v vb v vc]][w[c[v vf][v vi v vc]][g vj d[w[c[v vg][v vi v vc v vj]][c[v vh][v va v vj]]]]]]]].
d rvn[va a vb j[i[h[a] e]] vc d vd h[a a d] c ve h[a i[h[a] e] d] c vf h[a d] c vg h[a d d] c vh h[a d] c] c[q[v vb][e[v va][v va]][i[vi c vj i[h[a] e]][w[v vi][u[k rvm[v va v vj v vc v vd v ve v vf v vg v vh]]]]]].
d rvo[va i[h[a] e] vb d] c[g vc a[t[c[s[v va]][v vc]][v vb]]].
r jxperson[] a.
r jxanchor[] d.
r jxcreature[a d] c.
r jxwings[a d] c.
d jxtopic[va a] e[b vb[w[k jxcreature[v va v vb]][k jxwings[v va v vb]]]].
d jxalias[va a] e[k jxtopic[v va]].
r jxexperienced[a a d] c.
r jxdirected[a i[h[a] e] d] c.
r jxaversive[a d] c.
r jxanticipated[a d d] c.
r jxadverse[a d] c.
q[k rvm[k jxperson[] r[p jxtopic] k jxanchor[] p jxexperienced p jxdirected p jxaversive p jxanticipated p jxadverse]].
q[k rvm[k jxperson[] r[p jxalias] k jxanchor[] p jxexperienced p jxdirected p jxaversive p jxanticipated p jxadverse]].
q[k rvn[k jxperson[] l[i[h[a] e]][r[p jxtopic] r[p jxalias]] k jxanchor[] p jxexperienced p jxdirected p jxaversive p jxanticipated p jxadverse]].
q[k rvo[r[p jxtopic] k jxanchor[]]].
q[k rvo[r[p jxalias] k jxanchor[]]].
q[e[r[k rvm[k jxperson[] r[p jxtopic] k jxanchor[] p jxexperienced p jxdirected p jxaversive p jxanticipated p jxadverse]]][r[k rvm[k jxperson[] r[p jxtopic] k jxanchor[] p jxexperienced p jxdirected p jxaversive p jxanticipated p jxadverse]]]].
q[k rvn[k jxperson[] l[i[h[a] e]][] k jxanchor[] p jxexperienced p jxdirected p jxaversive p jxanticipated p jxadverse]].
q[k jxadverse[k jxperson[] k jxanchor[]]].
