p:
d rdr[va j[a] vb b] c[e[d[v va]][v vb]].
d riv[va a vb a vc a vd i[h[j[a]] e] ve j[a] vf c vg d vh d vi c vj h[j[a]] c vk h[a a a i[h[j[a]] e] j[a] c d] c] c[w[u[e[v vg][v vh]]][w[c[v vj][v ve]][w[z[c[v vk][v va v vb v vc v vd v ve v vf v vg]][u[v vi]]][z[c[v vk][v va v vb v vc v vd v ve v vf v vh]][v vi]]]]].
d rxx[va a vb a vc a vd i[h[j[a]] e] ve d vf h[a a a i[h[j[a]] e] j[a] c d] c] c[c[v vf][v va v vb v vc v vd l[a][] e[n p a b][n p a b] v ve]].
d rxz[va a vb a vc a vd i[h[j[a]] e] ve d vf d vg c vh h[a a a i[h[j[a]] e] j[a] c d] c] c[k riv[v va v vb v vc v vd l[a][] e[n p a b][n p a b] v ve v vf v vg i[vi j[a]][k rdr[v vi n p a b]] v vh]].
d rx2[va i[h[j[a]] e] vb i[h[j[a]] e] vc h[d] c] c[g vd d[w[c[v vc][v vd]][u[e[t[c[s[v va]][l[a][]]][v vd]][t[c[s[v vb]][l[a][]]][v vd]]]]]].
d rx3[va a vb a vc a vd i[h[j[a]] e] ve i[h[j[a]] e] vf h[d] c vg d vh d vi h[a a a i[h[j[a]] e] j[a] c d] c] c[w[k rxz[v va v vb v vc v vd v vg v vh u[e[n p a b][n p a b]] v vi]][w[k rxz[v va v vb v vc v ve v vg v vh e[n p a b][n p a b] v vi]][k rx2[v vd v ve v vf]]]].
d ryx[va a vb a vc a vd i[h[j[a]] e] ve i[h[j[a]] e] vf h[d] c vg d vh d vi h[a a a i[h[j[a]] e] j[a] c d] c] c[w[u[e[v vg][v vh]]][w[k rxx[v va v vb v vc v vd v vg v vi]][w[k rxx[v va v vb v vc v ve v vh v vi]][w[x[u[k rxx[v va v vb v vc v vd v vh v vi]]][u[k rxx[v va v vb v vc v ve v vg v vi]]]][k rx2[v vd v ve v vf]]]]]].
