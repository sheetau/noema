d rdm[va a vb a vc a vd a ve i[h[a a] e] vf c vg d vh h[a a a a i[h[a a] e] c d] c vi h[a a a a i[h[a a] e] c d] c] c[w[c[v vi][v va v vb v vc v vd v ve v vf v vg]][u[c[v vh][v va v vb v vc v vd v ve u[v vf] v vg]]]].
d rqta[va h[a] c vb h[a] c vc h[a a a] c vd h[a] i[h[a a] e] ve a vf d vg h[a a a a i[h[a a] e] c d] c vh h[a a a a i[h[a a] e] c d] c] c[w[g vi a[c[v va][v vi]]][f vj a[y[c[v va][v vj]][w[c[v vb][v vj]][w[g vk a[g vl a[c[v vc][v vj v vl v vk]]]][f vm a[f vn a[y[c[v vc][v vj v vn v vm]][k rdm[v ve v vj v vm v vn c[v vd][v vn] e[v vj][v vj] v vf v vg v vh]]]]]]]]]].
