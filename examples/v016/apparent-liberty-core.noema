d rdm[va a vb a vc a vd a ve i[h[a a] e] vf c vg d vh h[a a a a i[h[a a] e] c d] c vi h[a a a a i[h[a a] e] c d] c] c[w[c[v vi][v va v vb v vc v vd v ve v vf v vg]][u[c[v vh][v va v vb v vc v vd v ve u[v vf] v vg]]]].
d rro[va a vb i c[e] vc d vd h[a i c[e] d d] c] c[w[g ve d[c[v vd][v va v vb v vc v ve]]][f vf d[y[c[v vd][v va v vb v vc v vf]][t[s[v vb]][v vf]]]]].
d rwu[va h[a] c vb h[a a] c vc h[a a d] c vd h[a a d] c ve d] c[f vf a[f vg a[y[w[w[c[v va][v vf]][c[v vb][v vf v vg]]][c[v vc][v vf v vg v ve]]][c[v vd][v vf v vg v ve]]]]].
d rwv[va h[a] c vb h[a a] c vc h[a a d] c vd h[a a d] c ve d] c[w[k rwu[v va v vb v vc v vd v ve]][g vf a[g vg a[w[w[c[v va][v vf]][c[v vb][v vf v vg]]][w[c[v vd][v vf v vg v ve]][u[c[v vc][v vf v vg v ve]]]]]]]].
