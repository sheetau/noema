d iachighercivil[va a vb a vc d] c[k rdm[k iacsource[k iachigher[v vc]] v va k iacrole[v va v vb] v vb k iactarget[v vb] e[n p a b][n p a b] k iachigher[v vc] p iacrequired p iacallowed]].
d iachighermental[va a vb a vc d] c[k xd[v va k iacgoal[v va v vb] k iachigher[v vc] p iacavailable p iacprospects p iacevaluated]].
d iaclowercivil[va a vb a vc d] c[k rdm[k iacsource[k iaclower[v vc]] v va k iacrole[v va v vb] v vb k iactarget[v vb] e[n p a b][n p a b] k iaclower[v vc] p iacrequired p iacallowed]].
