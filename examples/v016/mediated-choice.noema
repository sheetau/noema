p:
d rz[va j[a] vb a] c[q[v va][u[e[n p a b][n p a b]]][i[vc c vd a][x[v vc][e[v vd][v vb]]]]].
d rs[va j[a]] j[h[a] c][q[v va][l[h[a] c][i[vb a][u[e[n p a b][n p a b]]]]][i[vc j[h[a] c] vd a][q[v vc][l[h[a] c][]][i[ve j[h[a] c] vf h[a] c][m[v ve][l[h[a] c][i[vg a][x[e[v vg][v vd]][c[v vf][v vg]]] i[vh a][w[u[e[v vh][v vd]]][c[v vf][v vh]]]]]]]]]].
d rt[va j[a]] c[f vb a[c[q[v va][i[vc c][e[n p a b][n p a b]]][i[vd h[c] c ve a][i[vf c][w[u[w[v vf][e[v ve][v vb]]]][c[v vd][x[v vf][e[v ve][v vb]]]]]]]][u[e[n p a b][n p a b]]]]].
d ru[va j[a] vb h[a h[a] c] c vc h[a] c vd h[a] c ve h[a] c] c[w[k rt[v va]][w[f vf a[y[u[k rz[v va v vf]]][u[c[v ve][v vf]]]]][q[v va][e[n p a b][n p a b]][i[vg c vh a][w[v vg][w[y[c[v vc][v vh]][z[c[v ve][v vh]][c[v vd][v vh]]]][y[u[c[v vc][v vh]]][z[c[v ve][v vh]][c[v vb][v vh v ve]]]]]]]]]].
d rv[va j[a] vb h[a h[a] c] c vc h[a] c vd h[a] c ve h[h[a] c] c] c[q[k rs[v va]][u[e[n p a b][n p a b]]][i[vf c vg h[a] c][x[v vf][w[k ru[v va v vb v vc v vd v vg]][c[v ve][v vg]]]]]].
d rw[va j[a] vb h[a h[a] c] c vc h[a] c vd h[a] c ve h[h[a] c] c] c[w[k rv[v va v vb v vc v vd i[vf h[a] c][e[n p a b][n p a b]]]][q[k rs[v va]][e[n p a b][n p a b]][i[vg c vh h[a] c][w[v vg][y[k ru[v va v vb v vc v vd v vh]][c[v ve][v vh]]]]]]].
d rxg[va j[a] vb h[a h[a] c] c vc a vd h[h[a] c] c ve h[h[a] c] c vf h[h[a] c] c vg h[a] c] c[w[k rz[v va v vc]][w[w[k ru[v va v vb i[vh a][u[e[n p a b][n p a b]]] i[vi a][u[e[n p a b][n p a b]]] v vg]][w[c[v vg][v vc]][w[c[v vd][v vg]][w[c[v ve][v vg]][c[v vf][v vg]]]]]][w[k rw[v va v vb i[vj a][e[v vj][v vc]] i[vk a][u[e[n p a b][n p a b]]] i[vl h[a] c][w[c[v ve][v vl]][w[z[c[v vd][v vl]][c[v vl][v vc]]][u[c[v vf][v vl]]]]]]][k rw[v va v vb i[vm a][e[v vm][v vc]] i[vn a][e[n p a b][n p a b]] i[vo h[a] c][w[c[v ve][v vo]][w[z[c[v vd][v vo]][c[v vo][v vc]]][c[v vf][v vo]]]]]]]]].
d rxh[va j[a] vb h[a h[a] c] c vc a vd h[h[a] c] c ve h[h[a] c] c vf h[h[a] c] c vg h[a] c vh a vi h[h[a] c] c vj h[h[a] c] c] c[w[k rxg[v va v vb v vc v vd v ve v vf v vg]][w[k rz[v va v vh]][w[u[e[v vc][v vh]]][w[c[v vg][v vh]][w[c[v vj][v vg]][w[c[v vi][v vg]][w[k rw[v va v vb i[vk a][e[v vk][v vc]] i[vl a][u[e[n p a b][n p a b]]] i[vm h[a] c][w[w[c[v ve][v vm]][w[c[v vj][v vm]][w[z[c[v vd][v vm]][c[v vm][v vc]]][z[c[v vi][v vm]][c[v vm][v vh]]]]]][u[c[v vm][v vh]]]]]][w[k rw[v va v vb i[vn a][e[v vn][v vc]] i[vo a][e[n p a b][n p a b]] i[vp h[a] c][w[w[c[v ve][v vp]][w[c[v vj][v vp]][w[z[c[v vd][v vp]][c[v vp][v vc]]][z[c[v vi][v vp]][c[v vp][v vh]]]]]][c[v vp][v vh]]]]][w[k rw[v va v vb i[vq a][x[e[v vq][v vc]][e[v vq][v vh]]] i[vr a][x[e[v vr][v vc]][u[e[n p a b][n p a b]]]] i[vs h[a] c][w[w[c[v ve][v vs]][w[c[v vj][v vs]][w[z[c[v vd][v vs]][c[v vs][v vc]]][z[c[v vi][v vs]][c[v vs][v vh]]]]]][u[c[v vf][v vs]]]]]][k rw[v va v vb i[vt a][x[e[v vt][v vc]][e[v vt][v vh]]] i[vu a][x[e[v vu][v vc]][e[v vu][v vh]]] i[vv h[a] c][w[w[c[v ve][v vv]][w[c[v vj][v vv]][w[z[c[v vd][v vv]][c[v vv][v vc]]][z[c[v vi][v vv]][c[v vv][v vh]]]]]][c[v vf][v vv]]]]]]]]]]]]]].
