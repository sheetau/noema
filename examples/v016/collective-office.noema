d rwm[va a vb j[a] vc h[j[c]] c] c[w[k rt[v vb]][w[k rz[v vb v va]][q[k rs[v vb]][u[e[n p a b][n p a b]]][i[vd c ve h[a] c][x[v vd][u[e[c[v vc][k rwl[v vb v ve]]][c[v vc][k rwl[v vb i[vf a][x[w[e[v vf][v va]][u[c[v ve][v vf]]]][w[u[e[v vf][v va]]][c[v ve][v vf]]]]]]]]]]]]]].
d rwn[va j[a] vb h[a] c vc h[j[c]] c] c[w[k rcm[v va v vb]][w[k hc[n p b b d[v va]]][q[v va][e[n p a b][n p a b]][i[vd c ve a][w[v vd][k rwm[v ve v va v vc]]]]]]].
d rwo[va a vb a vc d vd h[a a d] c ve h[a a a d] c] c[w[k rex[i[vf a][c[v vd][v vf v vb v vc]] i[vg a vh a][c[v ve][v vg v vh v vb v vc]]]][w[c[v vd][v va v vb v vc]][f vi a[y[w[c[v vd][v vi v vb v vc]][u[e[v vi][v va]]]][c[v ve][v va v vi v vb v vc]]]]]].
d rwp[va a vb a vc d vd h[a a d] c ve h[a a a d] c vf j[a] vg h[a a a d] c vh h[a] c vi h[j[c]] c] c[w[k rwo[v va v vb v vc v vd v ve]][w[k rwn[v vf i[vj a][c[v vg][v vj v va v vb v vc]] v vi]][f vk a[y[c[v vg][v vk v va v vb v vc]][c[v vh][v vk]]]]]].
