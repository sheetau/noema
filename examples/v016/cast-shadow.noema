d rvt[va a vb a vc a vd d ve h[a a d] c vf h[a a d] c vg h[a a a d] c vh h[a a d] c vi h[a a d] c vj h[a a d] c] c[w[g vk a[c[v ve][v vc v vk v vd]]][f vl a[y[c[v ve][v vc v vl v vd]][k rvq[v va v vb v vl v vd v vf v vg v vh v vi v vj]]]]].
