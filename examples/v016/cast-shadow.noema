d rvp[va a vb a vc a vd d ve a vf a vg h[a a d] c vh h[a a a d] c vi h[a a d] c] c[w[c[v vg][v va v ve v vd]][w[c[v vh][v ve v vc v vf v vd]][c[v vi][v vf v vb v vd]]]].
