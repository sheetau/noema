p:
d rex[va h[a] c vb h[a a] c] c[w[f vc a[y[c[v va][v vc]][u[c[v vb][v vc v vc]]]]][f vd a[f ve a[f vf a[y[w[c[v va][v vd]][w[c[v va][v ve]][w[c[v va][v vf]][w[c[v vb][v vd v ve]][c[v vb][v ve v vf]]]]]][c[v vb][v vd v vf]]]]]]].
d rwo[va a vb a vc d vd h[a a d] c ve h[a a a d] c] c[w[k rex[i[vf a][c[v vd][v vf v vb v vc]] i[vg a vh a][c[v ve][v vg v vh v vb v vc]]]][w[c[v vd][v va v vb v vc]][f vi a[y[w[c[v vd][v vi v vb v vc]][u[e[v vi][v va]]]][c[v ve][v va v vi v vb v vc]]]]]].
d ryv[va a vb a vc a vd a ve d vf h[a a d] c vg h[a a a d] c vh h[a a a d] c vi h[a a d] c] c[w[k rwo[v vc v vd v ve v vf v vg]][w[c[v vh][v va v vc v vd v ve]][c[v vi][v vd v vb v ve]]]].
