d rxr[va j[a] vb h[a] c vc h[a] a vd j[a] ve a vf h[a h[a] c] c vg h[a h[a] c] c vh h[h[a] c] c vi h[h[a] c] c vj h[a] c vk h[h[a] c] c vl h[h[a] c] c] c[w[k rxq[v va v vb v vc v vd v ve]][w[w[k ru[v vd v vf i[vm a][u[e[n p a b][n p a b]]] i[vn a][u[e[n p a b][n p a b]]] v vj]][w[f vo a[y[c[v vb][v vo]][w[c[v vj][c[v vc][v vo]]][c[v vg][v vo v vj]]]]][w[c[v vj][v ve]][w[c[v vk][v vj]][w[c[v vl][v vj]][w[c[v vh][v vj]][c[v vi][v vj]]]]]]]][w[k rw[v vd v vf i[vp a][g vq a[w[c[v vb][v vq]][e[v vp][c[v vc][v vq]]]]] i[vr a][u[e[n p a b][n p a b]]] i[vs h[a] c][w[w[c[v vh][v vs]][w[c[v vl][v vs]][w[f vt a[y[c[v vb][v vt]][z[c[v vg][v vt v vs]][c[v vs][c[v vc][v vt]]]]]][z[c[v vk][v vs]][c[v vs][v ve]]]]]][w[u[c[v vs][v ve]]][u[c[v vi][v vs]]]]]]][w[k rw[v vd v vf i[vu a][g vv a[w[c[v vb][v vv]][e[v vu][c[v vc][v vv]]]]] i[vw a][e[n p a b][n p a b]] i[vx h[a] c][w[w[c[v vh][v vx]][w[c[v vl][v vx]][w[f vy a[y[c[v vb][v vy]][z[c[v vg][v vy v vx]][c[v vx][c[v vc][v vy]]]]]][z[c[v vk][v vx]][c[v vx][v ve]]]]]][w[c[v vx][v ve]][c[v vi][v vx]]]]]][w[k rw[v vd v vf i[vz a][x[g v2 a[w[c[v vb][v v2]][e[v vz][c[v vc][v v2]]]]][e[v vz][v ve]]] i[v3 a][g v4 a[w[c[v vb][v v4]][e[v v3][c[v vc][v v4]]]]] i[v5 h[a] c][w[w[c[v vh][v v5]][w[c[v vl][v v5]][w[f v6 a[y[c[v vb][v v6]][z[c[v vg][v v6 v v5]][c[v v5][c[v vc][v v6]]]]]][z[c[v vk][v v5]][c[v v5][v ve]]]]]][w[u[c[v v5][v ve]]][u[c[v vi][v v5]]]]]]][k rw[v vd v vf i[v7 a][x[g vba a[w[c[v vb][v vba]][e[v v7][c[v vc][v vba]]]]][e[v v7][v ve]]] i[vbb a][e[n p a b][n p a b]] i[vbc h[a] c][w[w[c[v vh][v vbc]][w[c[v vl][v vbc]][w[f vbd a[y[c[v vb][v vbd]][z[c[v vg][v vbd v vbc]][c[v vbc][c[v vc][v vbd]]]]]][z[c[v vk][v vbc]][c[v vbc][v ve]]]]]][w[c[v vbc][v ve]][c[v vi][v vbc]]]]]]]]]]].
d rxs[va j[a] vb h[a] c vc h[a] a vd j[a] ve a vf h[a h[a] c] c vg h[a h[a] c] c vh h[h[a] c] c vi h[h[a] c] c vj h[a] c vk h[h[a] c] c vl h[h[a] c] c] c[w[k rxr[v va v vb v vc v vd v ve v vf v vg v vh v vi v vj v vk v vl]][f vm a[y[c[v vb][v vm]][k rw[v vd v vf i[vn a][g vo a[w[c[v vb][v vo]][e[v vn][c[v vc][v vo]]]]] i[vp a][w[g vq a[w[c[v vb][v vq]][e[v vp][c[v vc][v vq]]]]][u[e[v vp][c[v vc][v vm]]]]] i[vr h[a] c][w[w[c[v vh][v vr]][w[c[v vl][v vr]][w[f vs a[y[c[v vb][v vs]][z[c[v vg][v vs v vr]][c[v vr][c[v vc][v vs]]]]]][z[c[v vk][v vr]][c[v vr][v ve]]]]]][w[u[c[v vr][v ve]]][u[c[v vi][v vr]]]]]]]]]].
