p:
d rqsq[va h[a] c vb h[a a] c vc a vd a] c[w[c[v va][v vc]][w[c[v va][v vd]][w[u[e[v vc][v vd]]][w[f ve a[y[c[v va][v ve]][w[u[c[v vb][v ve v ve]]][w[x[e[v ve][v vc]][c[v vb][v vc v ve]]][x[e[v ve][v vd]][c[v vb][v ve v vd]]]]]]][w[f vf a[f vg a[y[w[c[v va][v vf]][c[v va][v vg]]][w[y[c[v vb][v vf v vg]][u[c[v vb][v vg v vf]]]][x[e[v vf][v vg]][x[c[v vb][v vf v vg]][c[v vb][v vg v vf]]]]]]]][f vh a[f vi a[f vj a[y[w[c[v va][v vh]][w[c[v va][v vi]][w[c[v va][v vj]][w[c[v vb][v vh v vi]][c[v vb][v vi v vj]]]]]][c[v vb][v vh v vj]]]]]]]]]]].
d rqsr[va h[d] c vb h[d] c vc h[a] c vd a ve a vf a] c[w[g vg d[c[v va][v vg]]][w[c[v vc][v vd]][w[z[e[v vd][v ve]][u[g vh d[w[c[v va][v vh]][c[v vb][v vh]]]]]][z[e[v vd][v vf]][f vi d[y[c[v va][v vi]][c[v vb][v vi]]]]]]]].
d rqss[va h[a] c vb h[a a] c vc h[a] c vd a ve a] c[w[g vf a[c[v vc][v vf]]][w[f vg a[y[c[v vc][v vg]][w[c[v va][v vg]][w[u[e[v vg][v vd]]][u[e[v vg][v ve]]]]]]][f vh a[f vi a[y[w[c[v vc][v vh]][w[c[v va][v vi]][w[c[v vb][v vh v vi]][u[e[v vi][v ve]]]]]][c[v vc][v vi]]]]]]].
d rqst[va h[d] c vb h[d] c vc h[d] c vd h[a] c ve h[a a] c vf a vg a vh a vi a] c[w[k rqsq[v vd v ve v vf v vg]][w[k rqsr[v va v vb v vd v vh v vf v vg]][w[k rqsr[v va v vc v vd v vi v vf v vg]][w[c[v ve][v vi v vh]][g vj d[w[c[v va][v vj]][w[c[v vb][v vj]][u[c[v vc][v vj]]]]]]]]]].
d rqsu[va h[d] c vb h[d] c vc h[d] c vd h[a] c ve h[a a] c vf h[a] c vg a vh a vi a] c[w[k rqsq[v vd v ve v vg v vh]][w[k rqss[v vd v ve v vf v vg v vh]][w[k rqsr[i[vj d][w[c[v va][v vj]][c[v vb][v vj]]] v vc v vd v vi v vg v vh]][c[v vf][v vi]]]]].
d rqsv[va h[d] c vb h[d] c vc h[d] c vd h[d] c ve h[a] c vf h[a a] c vg h[a] c vh a vi a vj a vk a vl a] c[w[k rqst[v va v vc v vd v ve v vf v vh v vi v vj v vk]][k rqsu[v va v vb v vc v ve v vf v vg v vh v vi v vl]]].
