d re[va a vb h[a] e vc h[d] c] c[g vd d[w[c[v vc][v vd]][t[c[v vb][v va]][v vd]]]].
d rxa[va i b[h[a] e] vb a vc h[d] c vd h[d d] c ve h[d d d] c vf h[i b[h[a] e] a d d] c] c[w[f vg d[y[c[v vc][v vg]][w[k ta[i[vh d][c[v vd][v vg v vh]] i[vi d vj d][c[v ve][v vg v vi v vj]]]][c[v vd][v vg v vg]]]]][w[g vk d[c[v vc][v vk]]][f vl d[y[c[v vc][v vl]][y[t[c[s[v va]][v vb]][v vl]][g vm d[w[c[v vd][v vl v vm]][w[c[v ve][v vl v vl v vm]][c[v vf][v va v vb v vl v vm]]]]]]]]]].
