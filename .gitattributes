# Preserve the user-supplied plan and the reference font/license bytes.
plan.md -text -whitespace
public/fonts/* -text -whitespace
.gitattributes text eol=lf
.gitignore text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.py text eol=lf
*.svg text eol=lf
*.noema text eol=lf
README.md text eol=lf

# Preserve pinned source and SVG bytes so provenance hashes survive checkout.
public/design/** -text whitespace=cr-at-eol
public/glyphs/** -text whitespace=cr-at-eol
public/examples/** -text whitespace=cr-at-eol
public/specimens/** -text whitespace=cr-at-eol
