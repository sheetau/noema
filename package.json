{
  "name": "noema-lp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4173",
    "build": "next build && node scripts/postbuild.mjs",
    "export": "npm run build",
    "preview": "node scripts/preview.mjs",
    "preview:lan": "node scripts/preview.mjs --host 0.0.0.0",
    "check": "node --test tests/site.test.mjs",
    "sync:release": "node scripts/export-release.mjs",
    "glyphs": "node scripts/export-samples.mjs && python -X utf8 -B scripts/generate-glyphs.py"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "lenis": "1.3.26",
    "next": "15.5.29",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
