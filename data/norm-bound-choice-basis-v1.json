{
  "status": "normative_practical_and_purposive_diagnostics_not_despotism_definition",
  "document": "examples/v016/kant-norm-bound-choice.noema",
  "library": "examples/v016/norm-bound-choice.noema",
  "parent": "examples/v016/kant-outcome-choice.noema",
