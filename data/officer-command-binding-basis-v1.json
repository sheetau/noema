  "primitives": {
    "aa": {
      "parameters": [
        "individual"
      ],
      "result": "truth",
      "arguments": [
        "person"
      ],
      "meaning_ja": "対象が人である。理解力・勇気・社会的地位の有無を人であることの条件にしない。"
    },
    "hzwn": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "holder",
        "role",
        "scene"
      ],
      "meaning_ja": "その状況で、その主体が社会的な実践の中で当該の役割を担う者として位置付けられている。役割の自己申告だけ、現在の行為、能力、資格要件の充足、法律上の免許の保有とは別の関係。実践の出所と範囲は状況の解釈で固定する。"
    },
    "dg": {
      "parameters": [
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "act",
        "context"
      ],
      "meaning_ja": "この文脈で、その行為が実際に生じる。行為の構成員や結果の因果的な説明は別条件である。"
    },
    "hzxf": {
      "parameters": [
        "individual",
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "person",
        "role",
        "community",
        "scene"
      ],
      "meaning_ja": "この共同体の制度・慣行に従い、この人が同じ役割に任じられ、その任用がこの状況でも有効である。自己申告や単なる活動実績とは分ける。制度の正当性、本人の能力、現在の活動、特定の任命儀礼は要求しない。共同体・任用された役割・時点を明示する。"
    },
    "f3": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "sender",
        "act",
        "context"
      ],
      "meaning_ja": "この人が同じ提示行為で示す側の当事者となる。単なる同席者や受け手としての参加とは区別する。"
    },
    "cf": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "person",
        "role",
        "situation"
      ],
      "meaning_ja": "その人にはその市民的な地位・職務が委ねられている。活動がその職務の遂行として位置付けられることはcbで別に要求する。"
    },
    "cg": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "person",
        "activity",
        "situation"
      ],
      "meaning_ja": "その人が記述された活動を、その状況で実際に行う。活動の種類・想定される立場・許可の存在とは別の事実。"
    },
    "h233d": {
      "parameters": [
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "institution",
        "point"
      ],
      "meaning_ja": "この状況で、この制度的集団は政治的共同体の軍務を担う軍事組織である。単に武器を持つ集団、武装した警察、競技団体とは区別する。現に戦闘中であることやその政治的正当性を要求しない。"
    },
    "h233e": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "role",
        "institution",
        "point"
      ],
      "meaning_ja": "同じ軍事組織・状況の階級制度で、この役職は、兵卒・下士官とは区別される将校の任官階級に位置付く。単に他人へ号令できることや教練を指導した実績では足りない。特定の現代国家の階級表、現在の指揮行為、貴族身分、能力や任官の正当性は付けない。保持者と有効な任用は別に結ぶ。"
    },
    "h242v": {
      "parameters": [
        "individual",
        "individual",
        {
          "kind": "sequence",
          "element": "individual"
        },
        "truth",
        {
          "kind": "description",
          "result": {
            "kind": "function",
            "parameters": [
              {
                "kind": "sequence",
                "element": "individual"
              },
              "truth"
            ],
            "result": "message"
          }
        },
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "notice",
        "recipient",
        "bindings",
        "polarity",
        "message_family",
        "point"
      ],
      "meaning_ja": "同じ提示行為で、この受け手へ、閉じた発話関数に同じ順序の個体列と同じ極性を渡した発話を示す。f2の対象引数を明示した複数束縛と極性へ一般化する。発話の命令・主張・質問という働きは渡す記述で構成し、関係だけで命令と決めない。生起・提示者・束縛先の受け手との同一性は合成側で結ぶ。内容の真理、受領、理解、服従、制度的な正当性は含意しない。"
    },
    "h242w": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "role",
        "institution",
        "reference"
      ],
      "meaning_ja": "この役職が、同じ制度的組織・基準の役職体系の範囲に属する。現在の保持者がいる役職だけに範囲を縮めず、別組織の同名の役職を混ぜない。役職間の上下、特定人物による保持・任用、指示の発出は別に確認する。"
    },
    "h242x": {
      "parameters": [
        "individual",
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "higher",
        "lower",
        "institution",
        "reference"
      ],
      "meaning_ja": "同じ組織・基準の役職体系で、第一役職が第二役職より上位の職務上の指揮関係に位置する。単なる社会的名声、年齢、給料の比較とは区別する。直接隣接の報告先だけでなく間接の上位も含めた順序として与え、非反射性・推移性は合成側で確認する。現在の命令発出や個別命令の正当性を含意しない。"
    }
  },
  "definitions": {
    "zzq": "その人がその活動を実行するという、状況ごとの内容。",
    "rdr": "個体を並べた引数列の長さが指定値に等しい。負数や非整数の長さには一致しない。",
    "h7f": "行為実行アダプター用の二つの個体引数という長さ規約。",
    "h7h": "引数列の順に本人・活動を取り、既存の同じ実行内容を返す。列長が二でない場合には成立せず、規範を呼ぶ側でもh7fを検査する。",
    "rex": "指定した対象範囲の関係が非反射的かつ推移的である。全順序や直接の隣接関係は要求しない。空範囲では真。範囲外の辺は検査対象外。",
    "rey": "rexが成立し、範囲内の第一対象から第二対象へ指定関係がある。異なる、比較可能な二対象を要求するので空範囲では偽。隣接辺から推移閉包を計算する定義ではない。",
    "rez": "同じ組織・状況の役職範囲と順序に対してreyが成立し、異なる二人がそれぞれ上位・下位の役職を保持する。所属、保持、上下の関係は明示的な引数であり、制度の正当性や命令権を含まない。",
    "hzae": "rezの同一組織の役職関係に、両者がその状況で該当職務を委ねられているcfを結ぶ。原文のOberenへの操作的な部分草案であり、軍制の説明ではない。",
    "r32j": "h7fでちょうど二個体の列を要求し、その同じ順序の本人・行為にh7hの実行内容を適用して、真偽が指定極性に一致するよう求める命令の発話を作る。肯定・否定の命令を同じ対象へ束縛し、命令の実際の発出や履行は別に扱う。長さ不適合の否定命令を自動的に充足したことにせず、提示側でもh7fを検査する。",
    "r32k": "既存r2toの将校分類を、同じ本人・明示した役職・軍事組織・基準へ固定する。人、役職保持hzwn、有効な任用hzxf、軍事組織h233d、同組織の将校階級h233e、委ねられた職務cfを結び、別の役職で将校であることを借りない。",
    "r32l": "同じ組織・基準の役職範囲h242wと指揮上の上下h242xを既存hzaeへ渡す。保持関係は同じ人・役職のhzwnと同じ組織への有効な任用hzxfをともに要求する。相異なる二人、同じ役職範囲の非反射的・推移的な上位関係、両者の職務を保持し、自分自身や他組織の上位者を上官として混ぜない。",
    "r32m": "同じ生起する提示行為dgで同じ提示者f3が、同じ受け手へ、その受け手自身と指定行為を順に束縛したr32jの同じ極性の命令を示す。h7fでちょうど二引数を確認し、内容の実際の真理・受領・正当性・規範の有効性を脱引用しない。",
    "r32n": "r32kの同じ将校・役職・軍事組織に、r32lの同じ上官・上位役職と、r32mの同じ発出者・受け手・提示行為・対象行為・極性を結ぶ。制度的な上下関係、命令が発出されたこと、本人の実行を区別する。"
  },
