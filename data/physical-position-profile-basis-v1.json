{
  "status": "optional_physical_position_profile",
  "document": "examples/v016/physical-position-profile-v1.noema",
  "definitions": {},
  "primitives": {
    "materialmember": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "body",
        "point",
        "context"
      ],
      "meaning_ja": "指定文脈で固定された物体を構成し、同じ物体の履歴を通じて追跡する物質点である。全物質点への関係として与え、測定済み標本だけの一覧ではない。時刻ごとに場所が一致する別の点への付け替えや、同じ空間位置という意味ではない。"
    },
    "cartesianmetric": {
      "parameters": [
        "individual",
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "frame",
        "lengthunit",
        "timeunit",
        "context"
      ],
      "meaning_ja": "この物体履歴の座標が、同じframeの校正された直交Cartesian空間基底と共通のlengthunitで与えられ、同じtimeunitの時刻規約で同時刻の出来事を比べることを指定する計量規約。三成分の差の二乗和は、その規約で測る物質点間距離の二乗である。時間や場所ごとに尺度を伸縮させて変形を隠す座標選択を認めず、物差しと局所時計の校正に整合させる。個々の出来事・物質点・値の帰属と全区間履歴は既存eiadで別に要求する。任意の異なる系の同時性や長さを同一視せず、Lorentz変換での長さ不変や加速物体の実現可能性はこの規約から導かない。"
    },
    "restinterval": {
      "parameters": [
        "individual",
        "individual",
        "individual",
        "individual",
        {
          "kind": "function",
          "parameters": [
            "number"
          ],
          "result": "truth"
        },
        {
          "kind": "function",
          "parameters": [
            "number"
          ],
          "result": "truth"
        },
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "point",
        "frame",
        "lengthunit",
        "timeunit",
        "lower",
        "upper",
        "context"
      ],
      "meaning_ja": "同じpointの位置と静止を論じるためにcontextで指定された、frame・長さ尺度・時間尺度と全対象期間であるという範囲規約。下限・上限は単なる任意の一瞬や静止して見える都合のよい標本ではなく、その設定で比較する非退化な全期間を指す。物質点の同一性と尺度を保持し、静止か否かを見てから期間を選ばない。履歴・静止の成立は別に要求する。"
    },
    "calibratedruler": {
      "parameters": [
        "individual",
        "individual",
        "individual",
        "individual",
        "individual",
        {
          "kind": "function",
          "parameters": [
            "number"
          ],
          "result": "truth"
        },
        {
          "kind": "function",
          "parameters": [
            "number"
          ],
          "result": "truth"
        },
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "ruler",
        "method",
        "frame",
        "unit",
        "timeunit",
        "lower",
        "upper",
        "context"
      ],
      "meaning_ja": "rulerがmethodで長さを比較し移し取るために用いる目盛付きの物差しであり、frameの同じunitへ校正され、lowerからupperがその使用の全期間を覆うという対応。目盛の等しい差が同じ長さの差を表す尺度を定め、端点の一致・置き直し・必要な分割によって長さを比較する。数字を書いた任意の物体ではない。全期間の剛性はeigyで別に要求し、全ての物差しが同じ三次元形状や非共線三標識点を持つとは要求しない。"
    },
    "positionrecord": {
      "parameters": [
        "individual",
        "individual",
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "record",
        "point",
        "frame",
        "unit",
        "context"
      ],
      "meaning_ja": "recordが同じ物質点pointの位置をframeの原点と正規直交軸に対して記述する幾何記録である。成分0–2は点、3–5は原点の位置を一つの共通の補助Euclid空間表示とunitで表し、6–14は同じ表示での三単位軸、15–17はframeでの三つの符号付きCartesian座標を表す。補助表示の原点と回転は任意だが全成分で共通にし、物理的な点・原点・軸の対応と校正された長さを保持する。記録内の整合性は射影の式で別に確認する。測定前から点の座標を知っているという前提ではなく、可能な測定結果の物理的解釈を指定する。"
    },
    "positioncomponent": {
      "parameters": [
        "individual",
        "number"
      ],
      "result": {
        "kind": "function",
        "parameters": [
          "number"
        ],
        "result": "truth"
      },
      "arguments": [
        "record",
        "slot"
      ],
      "meaning_ja": "同じ幾何記録のslotにある実数成分を返す。slotは0から17までの整数で、eisegの点・原点・三軸・出力三座標の順を保つ。それ以外の添字や未指定値を零で補わず未知として拒否する。返された切断の有効性や射影の整合性は別条件である。"
    },
    "rulerconstruction": {
      "parameters": [
        "individual",
        "individual",
        "individual",
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "method",
        "point",
        "frame",
        "unit",
        "record",
        "context"
      ],
      "meaning_ja": "methodの操作によって、同じframeの原点と軸に対するpointの位置を物差しで定め、結果をrecordとして得る。共通尺度での長さの比較・移し取り・分割と、直線・平行・直交のEuclid幾何学的作図を用い、原点から三直交軸方向への符号付き射影の長さから同じ点を再構成する。別々の点の測定値を混ぜず、位置決定と座標表現を同じ結果へ接続する。用いる物差しの全範囲はeisej、剛性と校正は別に確認する。この関係は操作が行われた設定での記述であり、現実での実施は可能性の引用から導かない。"
    },
    "usedruler": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "ruler",
        "method",
        "context"
      ],
      "meaning_ja": "rulerが同じmethodで用いる物差しの全範囲に属する。剛性や校正が確認できた道具だけを後から選ぶ標本ではない。一つの物差しを繰り返し用いる方法も許し、複数の物差しの現実の設置を必須にしない。使用道具があることと全道具の条件は別に合成する。"
    },
    "permittedmeasurement": {
      "parameters": [
        "individual",
        "individual",
        "individual",
        "individual",
        "situation",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "method",
        "point",
        "frame",
        "unit",
        "reference",
        "setting"
      ],
      "meaning_ja": "referenceの同じ静止物質点・frame・尺度と位置を保持した上で、methodによる位置決定を実行できる物理的・幾何学的に許容された設定settingである。理想的な剛体物差しと操作を用いる論説の記述尺度での実施可能性であり、無関係な世界で偶然同じ座標になることや単なる願望ではない。対象を移動・交換して測定容易な別位置へ変えること、隠れた単位変更を許さない。設定の許容性と、同じ方法が実際に位置決定の結果を与えることは別に要求する。現実に測定を行ったという主張ではない。"
    },
    "geometricbody": {
      "parameters": [
        "individual"
      ],
      "result": "truth",
      "arguments": [
        "body"
      ],
      "meaning_ja": "幾何学的形状を持つ物体。棒だけに制限しない。"
    },
