        "individual",
        {
          "kind": "function",
          "parameters": [
            "number"
          ],
          "result": "truth"
        },
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "frame",
        "chargeunit",
        "lengthunit",
        "timeunit",
        "magneticunit",
        "forceunit",
        "conversion",
        "context"
      ],
      "meaning_ja": "指定系の右手直交単位軸と同じ文脈で、長さ単位/時間単位で表示する速度、電荷単位、磁気側場の単位の積を力単位へ接続する正の係数conversionを定める規約。磁気側場は、電気的寄与を区別した移動電荷への速度依存の横向きの力を定める軸性の物理量として読む。原文の磁気側成分を、説明なしに現代SIの物質中のHや特定の透磁率へ置き換えない。係数は採用する場・単位の正規化を含み、1や1/cを原文へ無条件に補わない。実験の実施や一般的な微視的機構の証明を意味しない。"
    },
    "eirv": {
      "parameters": [
        "individual",
        "individual",
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "record",
