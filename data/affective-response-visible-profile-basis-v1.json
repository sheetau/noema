          }
        },
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "actor",
        "target",
        "description",
        "scene"
      ],
      "meaning_ja": "本人が、記述により捉えた対象のあり方へ向けて、親しみを伴う肯定的な感情を抱く。合理的な賛同、道徳的評価、利益、一時的な気分の快さだけとは分ける。対象とその記述の組が感情の向かう先であり、記述された性質の真実性や本人の信念をこの関係から推論しない。"
    },
    "affectioncomparison": {
      "parameters": [
