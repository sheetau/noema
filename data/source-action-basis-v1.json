{
  "status": "source_resolved_force_in_material_host",
  "document": "examples/v014/einstein-source-action.noema",
  "parent": "examples/v014/einstein-magnet-source.noema",
  "inherited_meaning_basis": "data/magnet-source-basis-v1.json",
  "primitives": {
    "eiry": {
      "parameters": [
        "individual",
        "individual",
        "individual",
