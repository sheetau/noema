  "inherited_meaning_basis": "data/role-commands-basis-v1.json",
  "definitions": {
    "rtr": "同じ本人・基準文脈で選んだ活動候補が、本人の希望する話題と程度の両方に属する。候補の実行は要求しない。",
    "rts": "rtrの全対象について、同じ出所・本人・役割・行為・閉じた記述を積極的に許可し、反対要求がない。選択は基準文脈に固定し、規範は評価状況で照合する。",
    "rtt": "各本人の希望する話題と程度の全組合せに、それと一致する活動候補が存在する。候補一覧から未許可の組合せを落とすだけでは網羅したことにならない。",
    "rtu": "候補範囲の網羅性rttと、その全対象への許可rtsを同時に要求する内容。",
    "rtv": "許可内容を述べる主張と服従内容を求める指令を、順序を保持した二つの発話記述として構成する。構成時にはどちらの内容も実行しない。",
    "rtw": "選択した全記録について、指定出所・本人・役割・活動・記述・極性の要求が基準文脈に存在し、同じ記述が評価状況でその極性を満たす。役割の範囲も検査する。",
    "rtx": "同じ出所・本人・基準文脈の、指定役割範囲に属する全活動・全記述・両極性の要求が記録に含まれる。選択した出所以外の要求を混ぜない。",
    "rty": "要求記録の網羅性rtxと、記録の妥当性・履行rtwを合わせた内容。要求の成立と履行の評価状況を分ける。",
    "rtz": "rtyの引数の閉じた記述から内容記述を構成する。命令の実行も、全記述域の列挙も行わない。",
    "r2tz": "同じ本人が自分の理性を用いる言語的検討の活動候補ca/h232pであり、その活動が指定された同じ話題h233sを扱うh227z。実行・許可・能力は候補の選別に使わない。",
    "r2ua": "同じ本人・活動・基準の許可対象を既存zzqの実行内容へ固定した閉じた記述。活動を実際に行ったことは要求しない。",
    "r2ub": "指定した一人について、希望する話題h233qと程度h233rの全組合せを既存rtuで扱う。同じ活動候補・役割・実行記述に同じ出所の積極的許可があり、反対要求がない。許可の評価点と希望の基準を分ける。",
    "r2uc": "同じ出所・本人・基準の全選択要求について、同じ立場・行為・内容・極性を本人が遂行の指示として受け入れ調整するh234b。要求の存在・全体の網羅・実際の履行は別条件である。",
    "r2ud": "固定した要求の全体の網羅rtx、記録の妥当性と評価点での履行rtw、同じ要求に従って遂行を調整するr2ucを合わせる。偶然の一致や抜けた要求を許さず、評価点で要求が消えたことを基準時の要求の消滅としない。",
    "r2ue": "同じ出所・基準で固定した全宛先についてr2ubの話題と量の自由選択への許可を要求する内容。宛先の範囲は実際に許可・実行した人から選ばない。空や単数の呼びかけを本文へ採用しない条件は発話側で結ぶ。",
    "r2uf": "同じ出所・基準で固定した全宛先についてr2udの要求に従う履行を求める内容。各宛先の範囲を許可の側と共用するが、実際の許可の成立をこの履行の条件に加えない。",
    "r2ug": "基準を固定し、出所を引数に、その出所の全宛先へのr2ueの許可方針を述べる発話の族を作る。命令形räsonnirtを許容的な働きとして読むための、許可内容の明示であり、議論の実行を強制しない。",
    "r2uh": "基準を固定し、出所を引数に、その出所の全宛先へr2ufの服従を求める命令の族を作る。許可を述べる発話とは別の型を保ち、引用から履行や正当性を導かない。"
  },
  "primitives": {
    "h233p": {
      "parameters": [
        "individual",
        "situation",
        "individual"
      ],
      "result": "truth",
      "arguments": [
        "source",
        "reference",
        "recipient"
      ],
      "meaning_ja": "同じ発信者が同じ基準場面で「あなた方」と呼びかける全宛先の範囲。受領・許可・実行・服従した人だけに狭めず、発信者を替えればその発信者の呼びかける範囲を照合する。人と複数性は発話への接続時に別に検査する。"
    },
    "h233q": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "person",
        "topic",
        "reference"
      ],
      "meaning_ja": "この本人が同じ基準場面で自ら論じたいと望む話題の全範囲。実際に論じた、許可された、安全な、正しい話題だけを選ばず、望む話題がない場合も許す。将来の選択や別人の希望を混ぜない。"
    },
    "h233r": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "person",
        "extent",
        "reference"
      ],
      "meaning_ja": "この本人が同じ基準場面で自ら望む議論の量・程度の全範囲。長さ・回数・詳しさ等、文脈で同定する程度指定を指し、許可された量や実際の遂行量とは区別する。数値単位や有限の上限を原文へ補わず、本人の希望が空の場合も許す。"
    },
    "h233s": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "individual",
      "arguments": [
        "person",
        "activity",
        "reference"
      ],
      "meaning_ja": "同じ本人の同じ活動候補について、基準で固定した議論の話題指定。複合的な話題も一つの指定として扱える。活動の主題であることはh227zへ別に接続し、実行済みの活動や許可済みの話題へ付け替えない。"
    },
    "h233t": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "individual",
      "arguments": [
        "person",
        "activity",
        "reference"
      ],
      "meaning_ja": "同じ本人の同じ活動候補について、基準で固定した議論の量・程度の指定。実際に達成した量の測定値ではなく、その量だけ論じるという候補の内容上の指定であり、許可結果に合わせて小さな量へ付け替えない。"
    },
    "h233u": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "individual",
      "arguments": [
        "person",
        "activity",
        "reference"
      ],
      "meaning_ja": "同じ本人が同じ議論の候補を行う際の立場の参照。許可と反対要求を同じ立場へ照合するために固定する。本文のこの発言だけから公的使用の学識者に限定せず、実行・役職保持・命令の正当性を参照だけで導かない。"
    },
    "h233v": {
      "parameters": [
        "individual",
        "individual",
        "situation",
        "individual"
      ],
      "result": "truth",
      "arguments": [
        "source",
        "person",
        "reference",
        "role"
      ],
      "meaning_ja": "同じ出所に対するこの本人の服従について、基準場面で扱う政治的・市民的な職務や立場の全範囲。私的な好みや無関係な他者の命令を含めず、不都合な要求がある立場を事後に除かない。正当な命令かどうかの判定とは分ける。"
    },
    "h233w": {
      "parameters": [
        "individual",
        "individual",
        "situation",
        "individual"
      ],
      "result": "truth",
      "arguments": [
        "source",
        "person",
        "reference",
        "item"
      ],
      "meaning_ja": "同じ出所・本人・基準場面について、服従の対象要求を記述する記録項目の範囲。要求の全体を尽くすこと、記録の真実性や履行は合成定義で別に検査し、記録を消して要求を消したことにはしない。"
    },
    "h233x": {
      "parameters": [
        "individual"
      ],
      "result": "individual",
      "arguments": [
        "item"
      ],
      "meaning_ja": "同じ要求記録の対象となる本人の立場。実際にその立場の要求であることは別に照合する。"
    },
    "h233y": {
      "parameters": [
        "individual"
      ],
      "result": "individual",
      "arguments": [
        "item"
      ],
      "meaning_ja": "同じ要求記録の対象行為。別の行為の実行で履行を代用せず、要求の照合と内容評価へ同じ参照を渡す。"
    },
    "h233z": {
      "parameters": [
        "individual"
      ],
      "result": {
        "kind": "description",
        "result": {
          "kind": "function",
          "parameters": [
            "individual",
            "individual"
          ],
          "result": "content"
        }
      },
      "arguments": [
        "item"
      ],
      "meaning_ja": "同じ要求記録の閉じた行為内容の記述。第一引数は本人、第二引数は対象行為であり、原語の文や題名だけで代用しない。要求への照合と履行評価で同じ記述を使う。"
    },
    "h234a": {
      "parameters": [
        "individual"
      ],
      "result": "truth",
      "arguments": [
        "item"
      ],
      "meaning_ja": "同じ要求記録の極性。真は指定内容を満たす要求、偽はその不成立を求める要求。要求の存在や履行の真偽とは別である。"
    },
    "h234b": {
      "parameters": [
        "individual",
        "individual",
        "individual",
        "individual",
        {
          "kind": "description",
          "result": {
            "kind": "function",
            "parameters": [
              "individual",
              "individual"
            ],
            "result": "content"
          }
        },
        "truth",
        "situation",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "source",
        "person",
        "role",
        "activity",
        "content",
        "polarity",
        "reference",
        "point"
      ],
      "meaning_ja": "この本人が評価点で、同じ出所・立場・行為・記述・極性の基準時の要求を、自分の当該遂行を導く指示として受け入れ、それに従って遂行を調整する。偶然同じ結果になっただけ、別要求を理由にした行動とは区別する。要求への道徳的賛同、無批判な信念、唯一の動機、要求の正当性や実際の履行成功はこの関係だけからは導かない。"
    }
  },
