          "result": "content"
        },
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "node",
        "author",
        "content_description",
        "context"
      ],
      "meaning_ja": "著者がこの文章箇所で指定された内容を主張する。著者への帰属であり、解釈器がその内容を真と認定する関係ではない。"
    },
    "quotedaddresseereference": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "individual",
      "arguments": [
        "document",
        "quoted_node",
        "presentation_context"
      ],
      "meaning_ja": "同じ文書・引用箇所・提示文脈で、引用された呼びかけの宛先として解釈する人物への文脈依存参照。一般的な読み手への呼びかけにも解釈上の対象を与えられるが、原文が特定の実在人物一名を名指したこと、実際の受領・同意・実行は含意しない。引用の内容から宛先の実在や性質を補わず、未指定の参照入力は拒否する。"
    }
  },
