          }
        },
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "本人",
        "本人について実現する目標の性質記述",
        "評価状況"
      ],
      "meaning_ja": "指定状況で、同じ本人が指定された目標の性質記述を本人について実現することに向け、文脈上十分な勇気を持つ。別の目標への勇気から推定しない。恐れ・困難に直面して行動へ向かう態度の十分さであり、客観的危険の有無・実行・成功を含意しない。"
    },
    "sufficientgoalunderstanding": {
      "parameters": [
        "individual",
        {
          "kind": "description",
          "result": {
            "kind": "function",
            "parameters": [
              "individual"
            ],
            "result": "content"
          }
        },
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "本人",
        "本人について実現する目標の性質記述",
        "評価状況"
      ],
      "meaning_ja": "指定状況で、同じ本人が指定された目標の性質記述を本人について実現するのに、理解能力が文脈上十分である。対象の区別・判断に使う能力の十分さをその目標について評価し、別の目標での十分さ、実際の使用、決意や勇気の十分さから推定しない。"
    },
    "presentspropertydefinition": {
      "parameters": [
        "individual",
        "individual",
        {
          "kind": "description",
          "result": {
            "kind": "function",
            "parameters": [
              "individual"
