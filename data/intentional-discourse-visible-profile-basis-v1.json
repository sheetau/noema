  "primitives": {
    "goaldirectedcourage": {
      "parameters": [
        "individual",
        "content",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "person",
        "goal",
        "situation"
      ],
      "meaning_ja": "その人が目的内容に向けて行動する勇気をその状況で持つ。目的への方向付けを含むが、実行・成功・成功の保証を含まない。勇気一般を目的内容と無関係に当てはめない。"
    },
    "activeactionparticipant": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "actor",
        "act",
        "context"
      ],
      "meaning_ja": "この人が、この文脈で当該行為に能動的な当事者として参加する。他人の行為が同時に起きただけでは含めない。"
    },
    "attemptsdescribedactivity": {
      "parameters": [
        "individual",
        "individual",
        {
          "kind": "description",
          "result": {
            "kind": "function",
            "parameters": [
              "individual"
            ],
            "result": "content"
          }
        },
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "person",
        "event",
        "task_description",
        "point"
      ],
      "meaning_ja": "この人がこの行為で、記述された活動をこの状況で試みる。試みたという経験を行為個体に結び、成功や能力を前提としない。"
    },
    "orderedutterancemotto": {
      "parameters": [
        {
          "kind": "sequence",
          "element": {
