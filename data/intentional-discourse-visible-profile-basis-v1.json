        "situation"
      ],
      "result": "truth",
      "arguments": [
        "quoted_parts",
        "topic_description",
        "context"
      ],
      "meaning_ja": "指定文脈で、順序付きの発話記述のまとまり全体を、指定した事柄の標語として位置付ける。各部分を個別の標語とすること、各発話の実行や達成、部分の同義性は含まない。事柄はNoemaの性質定義の記述で与える。"
    },
    "describedcausalcontribution": {
      "parameters": [
        "individual",
        {
          "kind": "description",
          "result": {
            "kind": "function",
            "parameters": [
              "individual"
            ],
