  "definitions": {},
  "primitives": {
    "mutualfriendship": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "first",
        "second",
        "context"
      ],
      "meaning_ja": "二人が互いを個人的な親愛・継続的な好意と関心を向け合う相手として関係を持つ。単なる面識、同席、業務上の協力又は一方だけの評価と区別する友人関係。個別の援助の実行、意見の一致、無条件の信頼は含意しない。"
    },
    "professionalcolleagues": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "first",
        "second",
        "context"
      ],
      "meaning_ja": "二人が同じ職業上の活動領域における仕事仲間として関係を持つ。私的な交友、仕事の一時的な援助だけとは区別する同僚関係。同じ雇用契約・階級・職場の所在地や共同著者であることは要求しない。"
    },
    "investigationtask": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "work",
        "problem",
        "context"
      ],
      "meaning_ja": "この研究活動が、指定された同じ問題を考察し解明しようとする作業である。問題の解決又は結論の真理は含意しない。"
    },
    "documentproblemfocus": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "document",
        "problem",
        "context"
      ],
      "meaning_ja": "この文書が指定問題をその本文の考察対象として扱う。単なる他文献の紹介や名前への言及だけとは区別する。考察の成功や問題の解決は含意しない。"
    },
    "closingremark": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "node",
        "document",
        "context"
      ],
      "meaning_ja": "この箇所が同じ文書の論述を閉じる際の付言として提示される。結語という談話上の役割であり、数学的結論・最終の物理命題・印刷物の最終行と同一視しない。後置の日付や編集注記を許す。"
    },
    "workepisodecoverage": {
      "parameters": [
        "individual",
        "individual",
        {
          "kind": "function",
          "parameters": [
            "situation"
          ],
          "result": "truth"
        },
        {
          "kind": "function",
          "parameters": [
            "situation"
          ],
          "result": "truth"
        },
        {
          "kind": "function",
          "parameters": [
            "situation"
          ],
          "result": "truth"
        },
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "recipient",
        "work",
        "history",
        "scope",
        "occasions",
        "context"
      ],
      "meaning_ja": "同じ本人が同じ研究に取り組んだ一続きの過去の作業を、history内のscopeが欠かさず指し、occasionsがその作業で支援の継続を評価すべき機会を全て指すという範囲の帰属。成功した支援だけから範囲を逆算せず、支援されなかった該当機会も含む。全ての時刻で行為を要求せず、別の研究や任意に短縮した区間を同一視しない。支援行為・意図・忠実さ自体の成立は含意しない。"
    },
    "calendaryearnumber": {
      "parameters": [
        "individual",
        "individual",
        "number",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "暦規約",
        "年期間",
        "年番号",
        "文脈"
      ],
      "meaning_ja": "指定した紀元・年の区切りを含む暦規約の下で、この年期間にこの年番号が付く。別の暦や文脈の同じ番号とは同一視しない。"
    },
    "orderedcalendarmonths": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": {
        "kind": "sequence",
        "element": "individual"
