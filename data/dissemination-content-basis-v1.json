  "definitions": {
    "r2lu": "同じ発信者・機会について、独立判断と自己離脱・伝播の既存hzr6を満たす話題と閉じた発話記述が存在する。発話の台詞を原文へ補わず、受領・理解・同じ性向の取得と因果を満たす存在を要求する。同じ発信者・機会では話題と抽象的発話内容を共用し、受け手ごとの経路と取得過程は別に存在してよい。",
    "r2lv": "r2lqの各人・各評価機会の条件をr2luへ替え、話題・発話の供給関数を除く。他の人、別の機会の発話を流用せず、複数人と指定部分集団、非空の評価機会と将来の取得を保持する。",
    "r2lw": "r2lrの同じ公衆・参照・期間・仮定経過を保ち、話題・発話を各人・機会の内部に存在量化したr2lvの内容族を作る。残る八供給関数を同じ候補へ渡す。",
    "r2lx": "r2lsと同じ自由条件の枠へr2lwを接続する。発話の文面を外から固定せず、条件内の同じ発信者と機会で存在を述べる。",
    "r2ly": "r2ltと同じ第一文の公衆・参照・出所・期間・起点・候補を共用し、r2lxへ接続する。第一文の主張内容と第二文の理由内容を同一視しない。",
    "r2lz": "同じ公衆・参照・仮定経過から、受け手本人の理由ある自己評価と全ての人の自己思考への課題を認めるhznuを応答とし、hzq6で数値なしの性向を構成する。基準・規範源・立場・通常性を固定し、応答と規範の現実の真理を区別する。",
    "r2m2": "r2lzへ同じ公衆・参照・仮定経過の値を引用適用し、閉じた性向記述を構成する。同じ記述が受け手の状態評価・取得の原因・持続へ渡る。発信者の独立判断の性向とは区別する。",
    "r2m3": "r2lyの八供給関数を全て充足する。受け手の性向はr2m2、社会的周囲はhzom、広がりはその範囲の異なる二人以上への取得rqsy、発信者の判断と評価機会は同じ公衆・参照・仮定経過の文脈入力へ結ぶ。部分集団だけを引数に残した条件付き内容の枠であり、任用された後見役の焦点・背景・著者帰属は別に接続する。",
    "r2m4": "閉じた性向記述へ渡す公衆と参照状況の呼称、および指定された全仮定候補の呼称を評価し、元の対象と等しいことを検査する。誤った呼称の候補を対象範囲から除いて成功させない。呼称の構文同一性は要求せず、指示対象の一致を要求する。"
  },
  "primitives": {
    "h222v": {
      "parameters": [
        "individual",
        "situation"
      ],
      "result": "individual",
      "arguments": [
        "audience",
        "reference"
      ],
      "meaning_ja": "同じ公衆・参照文脈で、人としての自己の価値・長所を理由に基づいて評定する基準。金銭価格や有用性だけの基準へ固定せず、原文にない特定の高評点を補わない。実際の評定の存在・高さ・正しさはこの入力から導かない。"
    },
    "h222w": {
      "parameters": [
        "individual",
        "situation"
      ],
      "result": "individual",
      "arguments": [
        "audience",
        "reference"
      ],
      "meaning_ja": "同じ公衆・参照文脈で、各人が自ら考える使命を論ずる事柄の参照。発信者ごとの具体的な伝達の話題とは区別する。規範内容そのものはhznqで全ての人への本人の思考要求として構成する。"
    },
    "h222x": {
      "parameters": [
        "individual",
        "situation"
      ],
      "result": "individual",
      "arguments": [
        "audience",
        "reference"
      ],
      "meaning_ja": "同じ公衆・参照文脈で、理性を用いる人として各人の自己思考を課題とする規範の出所。神・国家・雇用者へ同定せず、人としての理性的な立場に帰属させるという採用解釈。出所の実際の権威・正当性や、規範の現実の採用は含意しない。"
    },
    "h222y": {
      "parameters": [
        "individual",
        "situation"
      ],
      "result": "individual",
      "arguments": [
        "audience",
        "reference"
      ],
      "meaning_ja": "同じ公衆・参照文脈で、各人が人として理性を用いる立場。職業や任命された後見役の職務に限らない。hznqが全ての人の本人自身による思考要求をこの立場と規範源へ結ぶ。"
    },
    "h222z": {
      "parameters": [
        "individual",
        "situation",
        "situation",
        "individual",
        "situation",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "audience",
        "reference",
        "branch",
        "person",
        "anchor",
        "scene"
      ],
      "meaning_ja": "指定した仮定経過の本人・基準時に、自分の価値と人の自己思考への課題を判断する場面の範囲。本人の能力・利用できる理由・評価の機会を保った反事実的な場面を文脈から定める。成功する判断だけを選別せず、実際の一回の判断や受領の成否とは別に指定する。"
    },
    "h223a": {
      "parameters": [
