        },
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "node",
        "presenter",
        "classification",
        "entrusted_role",
        "context"
      ],
      "meaning_ja": "提示者がこの定義箇所で、指定分類の本人・活動・立場・基準について、同じ本人・立場・基準の委任関係が与える職務上の権限の範囲として、その活動類型を位置付ける。職務に伴って認められる使用の範囲という規範的な限定であり、単なる物理的能力や職業名の同一性ではない。委任・権限の現実の存在を引用時に実行せず、その時点の各指示への適合、個々の行為への無条件の実行許可、職務外の行為への許可は導かない。本人・立場の組は分類の第一・第三引数を共有する。"
    },
    "priorcontentdefinitionclarification": {
      "parameters": [
        "individual",
        "individual",
        "individual",
        {
          "kind": "description",
