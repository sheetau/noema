{
  "status": "optional_discourse_setting_profile",
  "document": "examples/v016/discourse-setting-profile-v1.noema",
  "definitions": {},
  "primitives": {
    "documentcontext": {
      "parameters": [
        "individual"
      ],
      "result": "situation",
      "arguments": [
        "document"
      ],
      "meaning_ja": "今回読む文書の本文を提示する文脈を指定する。同じ文書でも前付の名称表示の文脈とは区別し、両者の同一性を仮定しない。物理的状態の真偽や本文内容の成立を供給しない。"
    },
    "headingreference": {
      "parameters": [
        "situation",
        "number"
      ],
      "result": "individual",
      "arguments": [
        "context",
        "heading_item"
      ],
      "meaning_ja": "指定した本文提示文脈で、文書の先頭から数えた見出し項目の箇所を指す。見出しの階層や節番号によらず実際の出現順を1から数える。見出しが示す内容や主題は別に記述する。"
    },
    "discoursereferent": {
      "parameters": [
        "individual",
        "individual",
        "number",
        "situation"
      ],
      "result": "individual",
      "arguments": [
        "document",
        "node",
        "referent_item",
        "context"
      ],
      "meaning_ja": "同じ文書・提示文脈の指定箇所に結び付けて照合する対象参照。複数の対象はその箇所での導入順を1から数えて区別する。参照値を供給することから、導入操作の成立、現実の存在、条件の成立、世界での唯一性を導かない。"
    },
    "adoptsassumption": {
      "parameters": [
        "individual",
        "individual",
        {
          "kind": "description",
          "result": "content"
        },
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "node",
        "author",
        "content_description",
        "scope",
        "context"
      ],
      "meaning_ja": "著者が指定の文章箇所で内容の記述を仮定として採用し、指定した推論範囲へ置く。内容の真理、信念、証明を含意しない。"
    },
    "presentsmessage": {
      "parameters": [
        "individual",
        "individual",
        "individual",
        {
          "kind": "description",
          "result": "message"
        },
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "node",
        "author",
        "document",
        "message_description",
        "context"
      ],
      "meaning_ja": "著者が同じ文書・提示文脈のこの箇所で、閉じたmessageの記述が指定する発話の力と内容を読者へ提示する。指示・主張・問いを交換しない。帰属された発話の内容をその場で実行せず、読者の遵守、内容の真理、著者による実験実施を含意しない。"
    },
    "introducesreferent": {
      "parameters": [
        "individual",
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "node",
        "referent",
        "document",
        "context"
      ],
      "meaning_ja": "nodeで、documentの以後の議論に使う一つの対象をreferentとして設定し、後続の指示が同じ対象を保てるよう導入する操作。対象は仮定的な設定の中で選べ、物理的な実在や測定での同定の証明とは区別する。与える条件は別の仮定内容へ保持し、条件を満たす世界唯一の対象だとはしない。名称を付ける操作とも区別する。"
    },
    "physicalframe": {
      "parameters": [
        "individual"
      ],
      "result": "truth",
      "arguments": [
        "frame"
      ],
      "meaning_ja": "物理的な状態変化を参照する座標系。座標の構成と測定は未説明。"
    },
    "newtonianframe": {
      "parameters": [
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "frame",
        "context"
      ],
      "meaning_ja": "この座標系に関する物体の位置と時間、慣性質量と機械的作用の記述で、対象とするNewtonの力学方程式が成り立つという適格性。力を受けない物体の等速直線運動、力と運動変化の関係を同じ空間・時間尺度で記述し、座標選択だけで生じる見かけの力を加えない系を指定する。後続u0008でNewtonの方程式と明記される読みを採る。どの系が実際に適格かは物理的入力であり、座標系という名前だけから認めない。電気力学・光学の法則の成立、特定の相対速度・変換式・絶対静止をこの条件へ先取りしない。"
    }
  },
