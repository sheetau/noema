  "meaning_basis": "data/prejudice-depictions-basis-v1.json",
  "source": {
    "unit": "kant-1784:u0011",
    "unit_sha256": "7598b67d5af875405e69406729ea1bf9573a62c78e8bb946a77a0f23d3563680",
    "range": [
      449,
      845
    ],
    "text": "Besonders ist hiebei: daß das Publikum, welches zuvor von ihnen unter dieses Joch gebracht worden, sie hernach selbst zwingt darunter zu bleiben, wenn es von einigen seiner Vormünder, die selbst aller Aufklärung unfähig sind, dazu aufgewiegelt worden; so schädlich ist es Vorurtheile zu pflanzen, weil sie sich zuletzt an denen selbst rächen, die, oder deren Vorgänger, ihre Urheber gewesen sind."
  },
  "clauses": [
    {
      "range": [
        449,
        471
      ],
      "text": "Besonders ist hiebei: ",
      "definitions": [
        "r2nw",
        "h224r"
      ],
      "reading": "前二文の議論に関する特異な点として、同じ前半の内容を提示する。"
    },
    {
      "range": [
        471,
        489
      ],
      "text": "daß das Publikum, ",
      "definitions": [
        "r2ng",
        "r2nf",
        "r2la",
        "r2nd"
      ],
      "reading": "同じ著者が、先行文と同じ公衆範囲・成員について内容を帰属する。"
    },
    {
      "range": [
        489,
        503
      ],
      "text": "welches zuvor ",
      "definitions": [
        "r2ne",
        "r2mr"
      ],
      "reading": "同じ公衆の事例内で、先行作用は後の圧力開始より前である。"
    },
    {
      "range": [
        503,
        513
      ],
      "text": "von ihnen ",
      "definitions": [
        "h223x",
        "h223y",
        "r2mp"
      ],
      "reading": "先行作用を実際に担った文脈上の後見人たち。前文の自己思考者全員への同定は採らない。"
    },
    {
      "range": [
        513,
        531
      ],
      "text": "unter dieses Joch ",
      "definitions": [
        "r2no",
        "r2np",
        "r2nh",
        "bf",
        "hzpk"
      ],
      "reading": "前文の頚木を、同じ未成熟状態と同種の身体的拘束の描写として受ける。"
    },
    {
      "range": [
        531,
        548
      ],
      "text": "gebracht worden, ",
      "definitions": [
        "r2mp",
        "r2nc",
        "r2ml"
      ],
      "reading": "同じ共同行為が固定された全被作用者の未成熟の成立に寄与する。以前の自立を全員に要求しない。"
    },
    {
      "range": [
        548,
        560
      ],
      "text": "sie hernach ",
      "definitions": [
        "r2mr",
        "h223y"
      ],
      "reading": "先行作用の同じ参加後見人全員が後の被強制者となる。別の人へ選び直さない。"
    },
    {
      "range": [
        560,
        567
      ],
      "text": "selbst ",
      "definitions": [
        "r2nx",
        "r2ns",
        "r2nt"
      ],
      "reading": "作用を受けた公衆自身が強制の担い手になることを、条件付きのまま取り立てる。"
    },
    {
      "range": [
        567,
        574
      ],
      "text": "zwingt ",
      "definitions": [
        "r2mn",
        "r2mm",
        "r2ml",
        "h223n"
      ],
      "reading": "公衆に帰属する参加行為と、身体的制約または脅しによる強制、保持への実際の因果を要求する。"
    },
    {
      "range": [
        574,
        595
      ],
      "text": "darunter zu bleiben, ",
      "definitions": [
        "r2mk",
        "r2np",
        "r2nh"
      ],
      "reading": "同じ未成熟状態が正の保持期間全体に成立する。頚木の種類の照応も保持する。"
    },
    {
      "range": [
        595,
        603
      ],
      "text": "wenn es ",
      "definitions": [
        "r2mr",
        "r2mq"
      ],
      "reading": "同じ公衆の扇動条件が成立するなら後の保持が成立する。強制の無条件化はしない。"
    },
    {
      "range": [
        603,
        633
      ],
      "text": "von einigen seiner Vormünder, ",
      "definitions": [
        "r2mq",
        "r2mu",
        "r2m5"
      ],
      "reading": "同じ公衆の後見役を担う異なる二人以上。先行後見人との重なりは許し、全員でないとは要求しない。"
    },
    {
      "range": [
        633,
        644
      ],
      "text": "die selbst ",
      "definitions": [
        "r2nx",
        "r2nu",
        "r2nv"
      ],
      "reading": "条件内の同じ扇動者全員について、本人の不能を取り立てる。全後見人へ広げない。"
    },
    {
      "range": [
        644,
        675
      ],
      "text": "aller Aufklärung unfähig sind, ",
      "definitions": [
        "r2mt",
        "up"
      ],
      "reading": "固定した取得機会の全域で、自力・学習・助力を含む達成方法が利用できない。全世界の永久不能へ強めない。"
    },
    {
      "range": [
        675,
        680
      ],
      "text": "dazu ",
      "definitions": [
        "r2nb",
        "r2na",
        "h224l"
      ],
      "reading": "公衆が後見人を未成熟に保持する同じ予定圧力行為を指す。閉じた名前を元の行為と照合する。"
    },
    {
      "range": [
        680,
        701
      ],
      "text": "aufgewiegelt worden; ",
      "definitions": [
        "r2na",
        "r2mz",
        "h223s",
        "h223t",
        "h223u"
      ],
      "reading": "同じ後見人の働きかけの受領・理解・感情への訴えと、反抗的な気分・参加への構えに至る因果。後の実行そのものとは分ける。"
    },
    {
      "range": [
        701,
        721
      ],
      "text": "so schädlich ist es ",
      "definitions": [
        "r2ou",
        "r2ot",
        "r2os",
        "r2ov"
      ],
      "reading": "前半の同じ条件付き内容を受け、同じ事例全体の害を高程度として評価する。個別の大損害・数値は補わない。"
    },
    {
      "range": [
        721,
        733
      ],
      "text": "Vorurtheile ",
      "definitions": [
        "r2nz",
        "r2oa",
        "r2ob",
        "h224w",
        "h224x"
      ],
      "reading": "十分に吟味しない意見を確立した原理として採用すること。意見の偽性とは同一視しない。"
    },
    {
      "range": [
        733,
        746
      ],
      "text": "zu pflanzen, ",
      "definitions": [
        "r2pc",
        "r2pd",
        "r2ph",
        "r2pa"
      ],
      "reading": "同じ意見・受け手への採用生成を、生育を目的とする植え付けで非字義的に描く。"
    },
    {
      "range": [
        746,
        751
      ],
      "text": "weil ",
      "definitions": [
        "r2ow",
        "ud",
        "ue"
      ],
      "reading": "反作用の理由節から有害さの評価へ根拠を向け、前半・評価・理由の本文順を保持する。"
    },
    {
      "range": [
        751,
        760
      ],
      "text": "sie sich ",
      "definitions": [
        "r2om",
        "r2on",
        "r2pl",
        "r2pm"
      ],
      "reading": "植え付けた同じ意見を反作用の要因とし、描写では応答主体とする。自傷の対象とは読まない。"
    },
    {
      "range": [
        760,
        768
      ],
      "text": "zuletzt ",
      "definitions": [
        "r2oh",
        "r2oi"
      ],
      "reading": "同じ文脈上の経過の終点。世界全体の最後や最初の被害時は要求しない。"
    },
    {
      "range": [
        768,
        784
      ],
      "text": "an denen selbst ",
      "definitions": [
        "r2oo",
        "r2om",
        "r2on"
      ],
      "reading": "生み手本人またはその役割を継いだ人が、まさに害を受けることを取り立てる。"
    },
    {
      "range": [
        784,
        792
      ],
      "text": "rächen, ",
      "definitions": [
        "r2oe",
        "r2pk",
        "r2pj",
        "r2pm"
      ],
      "reading": "偏見採用から本人側への害という対象内容を、意図を伴う応報の描写に結ぶ。"
    },
    {
      "range": [
        792,
        819
      ],
      "text": "die, oder deren Vorgänger, ",
      "definitions": [
        "r2og",
        "r2of",
        "h225a"
      ],
      "reading": "生み手が被害者本人である枝、または同じ実践の役割の先任者である枝の選言。血縁・単なる先行ではない。"
    },
    {
      "range": [
        819,
        845
      ],
      "text": "ihre Urheber gewesen sind.",
      "definitions": [
        "r2ob",
        "r2og",
        "r2oj",
        "r2ok"
      ],
      "reading": "同じ意見の採用を先行時点に生じさせた人。全関連事例・対象者を量化し、世界最初の発明者とは限定しない。"
    }
  ],
