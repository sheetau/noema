      ],
      "text": "Aber ",
      "definitions": [
        "h222q",
        "r5kk",
        "r5kj"
      ],
      "reading": "前文の暫定的な可能性と、公的問い直しを禁じる制度固定化の禁止を対照する。"
    },
    {
      "range": [
        2315,
        2337
      ],
      "text": "auf eine beharrliche, ",
      "definitions": [
        "r5jf",
        "r5jg",
        "r5jh"
      ],
      "reading": "同じ配置を全期間にわたり持続させること。有界・終点なしを共通に扱う。"
    },
    {
      "range": [
        2337,
        2399
      ],
      "text": "von Niemanden öffentlich zu bezweifelnde Religionsverfassung, ",
      "definitions": [
        "r5h3",
        "r5h4",
        "r5h5",
        "r5jg"
      ],
      "reading": "同じ宗教制度に対する全人の公的問い直しを禁止する。現実の疑念や批判の不在ではない。"
    },
    {
      "range": [
        2399,
        2447
      ],
      "text": "auch nur binnen der Lebensdauer eines Menschen, ",
      "definitions": [
        "r5ji",
        "r5kh",
        "h26fg"
      ],
      "reading": "同じ一人の生涯内という限定部分にまで及ぶ禁止。全禁止範囲を限定部分へ縮めない。"
    },
    {
      "range": [
        2447,
        2464
      ],
      "text": "sich zu einigen, ",
      "definitions": [
        "r5ja",
        "r5jh",
        "r5js",
        "r5jt",
        "r5ju"
      ],
      "reading": "同じ全当事者の同じ内容への共同合意形成を禁止の対象にする。宣誓や全住民の同意を追加しない。"
    },
    {
      "range": [
        2464,
        2476
      ],
      "text": "und dadurch ",
      "definitions": [
        "r5jr",
        "r5jw",
        "r5kf"
      ],
      "reading": "同じ合意方針の実施から同じ期間の不毛化への因果的帰結。単なる併存ではない。"
    },
    {
      "range": [
        2476,
        2540
      ],
      "text": "einen Zeitraum in dem Fortgange der Menschheit zur Verbesserung ",
      "definitions": [
        "r5jj",
        "r5jk",
        "r5jl",
        "r5jm"
      ],
      "reading": "同じ期間の全人類について、認識獲得・理由ある訂正・理由ある自己判断の改善を全前後点で比較する。"
    },
    {
      "range": [
        2540,
        2565
      ],
      "text": "gleichsam zu vernichten, ",
      "definitions": [
        "r5kb",
        "r5kc",
        "h26fc"
      ],
      "reading": "同じ期間を消失させる姿への見立て。字義的な消失を世界の真理条件へ連言しない。"
    },
    {
      "range": [
        2565,
        2580
      ],
      "text": "und fruchtlos, ",
      "definitions": [
        "r5jo",
        "r5kg"
      ],
      "reading": "同じ全期間に改善がないという結果。未知・絶滅・別期間の停滞を代用しない。"
    },
    {
      "range": [
        2580,
        2602
      ],
      "text": "dadurch aber wohl gar ",
      "definitions": [
        "r5j5",
        "r5j6",
        "r5ka",
        "h26fe",
        "h26fd"
      ],
      "reading": "不毛化から害への第二の因果的帰結を、推量を保った対照・増幅として提示する。"
    },
    {
      "range": [
        2602,
        2636
      ],
      "text": "der Nachkommenschaft nachtheilig, ",
      "definitions": [
        "r5jy",
        "r5jz",
        "r5j2",
        "r5j3",
        "r5j7"
      ],
      "reading": "合意の時代より後の全人を含む集団の知的継承・発展の機会の不利益。全員の個別被害にしない。"
    },
    {
      "range": [
        2636,
