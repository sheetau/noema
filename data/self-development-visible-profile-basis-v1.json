  "primitives": {
    "populationfewerthreshold": {
      "parameters": [
        "number",
        "situation"
      ],
      "result": "number",
      "arguments": [
        "population_size",
        "context"
      ],
      "meaning_ja": "この母集団の全人数と基準文脈で、少ないという数量評価に採る正の上限候補。原文の具体的な数値とはしない。総人数への依存を明示し、絶対人数基準や比率から得た人数基準を区別して設定できる。上限の適切さは別の解釈上の前提。"
    },
    "contextualcountpopulation": {
      "parameters": [
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "person",
        "context"
      ],
      "meaning_ja": "この基準文脈で、段落末の少数者を数える対象範囲に入る個体。人であることはaaで別に要求し、成功者だけを選んだ標本や、仮定ごとに入れ替わる対象集合とはしない。"
    },
    "controlledbodybalance": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "person",
        "act",
        "point"
      ],
      "meaning_ja": "この同じ脚による移動中、本人の身体の姿勢・支持への荷重の移し方が制御され、均衡を保っている。単に転倒していないことや偶然支えられた結果だけとは区別する。具体的な力学条件・許容差・制御機構は未説明。"
    },
    "controlledfootplacement": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "person",
        "act",
        "point"
      ],
      "meaning_ja": "この同じ移動中、本人の足の置き方や接地の更新が、行おうとする移動の方向・支持に沿って制御されている。毎瞬間足を動かしていることではなく、現在の配置や次の配置への移行を制御している。機構と誤差の尺度は未説明。"
    },
    "wholeintellectualprocesspoint": {
      "parameters": [
        "individual",
        "situation",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "episode",
        "last",
        "point"
      ],
      "meaning_ja": "この完了点で記述する同じ知的活動の全過程の範囲に入る状況。失敗した判断の時点を選択的に除かない。準備や判断の間の時点も含む。"
    },
    "episodejudgmentpart": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "judgment",
        "episode",
        "point"
      ],
      "meaning_ja": "この状況で、この判断が同じ知的活動を構成する部分である。単に同時に行われる別の活動の判断とは区別する。活動の個体化と部分関係の基礎は未完。"
    },
    "countfocusalternatives": {
      "parameters": [
        "number",
        "situation"
      ],
      "result": {
        "kind": "sequence",
        "element": {
          "kind": "function",
