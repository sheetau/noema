      "range": [
        356,
        375
      ],
      "text": "des eigenen Werths ",
      "definitions": [
        "hznu",
        "h222v"
      ],
      "reading": "受け手本人の人としての価値・長所。発信者だけの価値や金銭価格へ取り替えない。"
