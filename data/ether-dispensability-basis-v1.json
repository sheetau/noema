            "parameters": [
              "individual",
              "situation"
            ],
            "result": "truth"
          }
        },
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "view",
        "grounds",
        "conclusion",
        "reference"
      ],
      "meaning_ja": "同じviewについて、groundsが示す点・範囲における帰結としてconclusionを理由付けるという限定付きの説明関係。その限りでという範囲を保ち、単なる並置、無限定な全目的への一般化、必要十分条件の同値とは区別する。閉じた両型は同じviewと判断点へ結び、対象や意味を途中で交換しない。ここでの不要性を他の目的での不要性や対象の実在否定へ広げない。"
    },
    "eisdb": {
      "parameters": [
        "individual",
        {
          "kind": "description",
          "result": {
            "kind": "function",
            "parameters": [
              "individual",
              "situation"
            ],
            "result": "truth"
          }
        },
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "view",
        "claim",
        "document",
        "reference"
      ],
      "meaning_ja": "同じdocumentのこれからの理論展開で、同じviewについてclaimの成立が明らかになると予告する。単なる願望や可能性ではなく、今後の結果への主張として提示する。閉じた型へ同じviewを与えるが、今この時点で実証・導出が完了済みという事実へ替えない。処理系がその予告の物理的真理を証明したことも含意しない。"
    },
    "eisdc": {
      "parameters": [],
      "result": "individual",
      "arguments": [],
      "meaning_ja": "固定原文einstein-1905:u0004[1082,1425)の第四文。開発予定の見解における二つの不導入・不付与を理由とし、その限りで光エーテル導入の不要が明らかになると予告する箇所。"
    }
  },
  "definitions": {
    "eigm": "同じ速度記録についてeisc4の速度量としての意味と、eisc5の三成分の有効性を結ぶ。sch2を同じベクトルへ二度渡して軸の相違と実数成分を検査し、零速度も除外しない。",
    "eign": "同じ空間範囲に、既存の電荷輸送・電気的作用・磁気的作用の物理語彙で記述される電磁過程がある。過程を空間内の各点へ個別に要求しない。",
    "eigo": "同じviewが、絶対静止を備えた空間概念を導入し、かつそれに特殊な物理的性質を帰属するという組が存在しない。普通の幾何学的空間や相対静止の禁止ではない。",
    "eigp": "電磁過程が生じる真空空間のどの点にも、同じviewで有効な速度ベクトルを付与する組が存在しない。零を含む全速度記録を対象とし、物体や光の速度を否定しない。",
    "eigq": "絶対静止空間の不導入eigoと真空の点への速度不付与eigpを同じ見解・判断点で結ぶ。weder/nochの二つの否定を片方へ縮めない。",
    "eigr": "同じ物理的対象・量・説明を保持する記述の仕方があり、それが先行の光媒体eisbyを理論構成要素として導入しない。光エーテルの導入がこの論点で不要という内容であり、存在しないという主張ではない。",
    "eigs": "同じviewで二つの否定eigqを述べ、その点・範囲を理由として同じ不要性eigrが今後の論説展開で明らかになると予告する。不要性の現在の実証完了は要求しない。",
    "eigt": "前文の同じ理論構成eigjについてこれから展開する見解があり、その同じ見解についてeigsの二否定・限定付き理由・不要性の予告が成立するという第四文の内容。",
    "eigu": "eigtの内容を主張するメッセージ。未来の予告を現在の完成証明や単なる希望へ替えない。",
    "eigv": "第四文のeiguを同じ著者・論説へ帰属し、第三文に続く別箇所として本文順序を保持する。"
  },
