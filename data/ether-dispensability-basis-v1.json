  "primitives": {
    "eiscv": {
      "parameters": [
        "individual",
        "individual",
        {
          "kind": "description",
          "result": "content"
        },
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "view",
        "document",
        "project",
        "reference"
      ],
      "meaning_ja": "viewが、同じdocumentでこれから展開するprojectの理論構成についての見解・概念的な記述規約である。先行の構成課題を同じ内容として参照し、他者の既成理論や現在の読者の見解へ替えない。将来の本文で展開するという位置付けを含み、展開や証明が既に完了したことは要求しない。計画された理論を記述対象とすることと、その物理的真理は別である。"
    },
    "eiscw": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "view",
        "concept",
        "reference"
      ],
      "meaning_ja": "viewがconceptで指定する対象・概念を、物理的記述や説明のための理論的な構成要素として導入する。語への言及、他説の引用、否定するための参照だけとは区別する。導入の有無はその理論の全規約について与え、未調査を不導入としない。導入すること自体は対象の実在の実証ではなく、不導入はその実在の否定ではない。"
    },
    "eiscx": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "space",
        "rest",
        "reference"
      ],
      "meaning_ja": "spaceが、restで指定する絶対静止を空間自体の特権的な状態として持つと考える理論的空間の概念である。どの物体や任意の座標系を選ぶかによらない静止の基準を空間へ置くことを意味し、ある系に対する位置不変や座標格子の選択だけとは区別する。その空間の実在やこの見解による導入は別の条件である。"
    },
    "eiscy": {
      "parameters": [
        "individual",
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "view",
        "space",
        "property",
        "reference"
      ],
      "meaning_ja": "viewがspaceに、普通の位置・幾何学的座標の指定を超えて物理的に特権的な静止を特徴付ける特殊なpropertyを備えさせる。特定の属性名や測定値は原文へ補わない。この属性の帰属を、空間を実際に理論へ導入することやその実在の証明と同一視しない。"
    },
    "eiscz": {
      "parameters": [
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "region",
        "reference"
      ],
      "meaning_ja": "regionが、この物理的記述で物質的な伝播媒体を置かない真空の空間範囲である。電磁場や光の存在を排除せず、空間全体や任意の領域を扱い、既に観測した有限部分だけに限定しない。物質媒体が未検出だから真空だと推論する関係ではない。"
    },
    "eisc2": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "point",
        "region",
        "reference"
      ],
      "meaning_ja": "pointが同じregionに属する空間的位置である。空間点の全範囲に対する関係として与え、物質点、電荷担体、光線や測定済み位置だけへ替えない。点に座標を与えることと、点自体を運動する物理的対象として扱うことを区別する。"
    },
