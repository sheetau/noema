{
  "status": "optional_constitution_effort_visible_profile",
  "document": "examples/v016/constitution-effort-visible-profile-v1.noema",
  "definitions": {},
  "primitives": {
    "cognitiveactivitycomponent": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "part",
        "person",
        "point"
      ],
      "meaning_ja": "この人の精神的な営みを構成する、考え方・判断の習慣・認知的な働きなどの一部分。物理的な脳器官や任意の所有物とは区別する。Geistの全語義と精神の構成理論は未完。"
    },
    "reflectivecomponentreworking": {
      "parameters": [
        "individual",
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "person",
        "part",
        "act",
        "point"
      ],
      "meaning_ja": "本人がこの活動で、その精神的な部分のあり方を吟味し、組み直すように働きかける。改善の成功や自立の達成は含意せず、単なる既存の能力の使用とも区別する。活動内部の方法・努力量・反復は未確定。"
    },
    "internalprocessconstitution": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "pattern",
        "person",
        "point"
      ],
      "meaning_ja": "この組織化された過程の構成が、この時点でこの本人の内的な構成として存在する。所有物や外部の指導者とは分ける。構成の活動、形成の原因、性質への寄与、生得的か後天的かは別条件である。"
    },
    "constitutedprocessoperation": {
      "parameters": [
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "pattern",
        "point"
      ],
      "meaning_ja": "この組織化された構成による過程が、この局面で作動している。構成が存在するだけ、実行された回数、特定の結果への寄与とは区別する。身体的・心理的な機構の細部をこの関係だけで還元したとはしない。"
    },
    "externalsustenancecomparison": {
      "parameters": [
        "individual",
        "individual",
        {
          "kind": "description",
          "result": {
            "kind": "function",
            "parameters": [
              "individual"
            ],
            "result": "content"
          }
        },
        "situation",
        "situation",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "pattern",
        "person",
        "description",
        "anchor",
        "point",
        "candidate"
      ],
      "meaning_ja": "固定した評価文脈で、本人の指定履歴点の内的構成と関連する背景を保ち、記述した性質への外からの維持作用の更新を比較する候補局面。履歴点自体の状態や比較後の性質の成立を保存条件にしない。比較する経過期間と背景は文脈入力とし、成立した結果で候補を選ばない。学習し直した別の構成や別人への変更も含めない。"
    },
    "renewedexternalmaintenance": {
      "parameters": [
        "individual",
        {
          "kind": "description",
          "result": {
            "kind": "function",
            "parameters": [
              "individual"
            ],
            "result": "content"
          }
        },
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "person",
        "description",
        "candidate"
      ],
      "meaning_ja": "この比較局面で、記述した性質をこの本人について維持する外部からの働きかけが更新されている。単なる外物の存在、通常の生命維持条件、過去の指導の履歴とは分ける。未知の更新を不存在として入力してはいけない。"
    },
    "practicalpolicydecision": {
      "parameters": [
        "individual",
        "individual",
        {
          "kind": "description",
          "result": {
            "kind": "function",
            "parameters": [
              "individual"
            ],
            "result": "content"
          }
        },
        "truth",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "judgment",
        "target",
        "description",
        "polarity",
        "point"
      ],
      "meaning_ja": "この判断は、当該局面の選択肢を検討した上で、指定対象を記述された状態にする、またはその状態に保つ方針を新たに採る実践的な決定である。極性が偽なら、その状態を避ける、またはやめる方針を採る。主体はfaで別に結ぶ。事実についての肯定判断hznn、単なる希望、以前からの方針、成功や能力とは別である。対象の記述に適した認知上の捉え方は解釈時に必要であり、本人が機構の細部を知ることを要求しない。"
    },
    "freshdecisioncomparison": {
      "parameters": [
        "individual",
        "individual",
        {
          "kind": "description",
          "result": {
            "kind": "function",
            "parameters": [
              "individual"
            ],
            "result": "content"
          }
        },
        "situation",
        "situation",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "target",
        "person",
        "description",
        "anchor",
        "point",
        "candidate"
      ],
      "meaning_ja": "指定履歴点における本人と対象の関連する構成、以前からの方針、知識、機会を保ち、記述された状態についてその都度検討して決めることを比較できる局面。新たな決定の有無・極性を変え得る比較とし、その結果や対象の作動を保存条件にしない。本人が新しく訓練された場合や別人に置き換わった場合は含めない。比較期間・背景・実践的決定の区切りは文脈入力である。"
    },
    "methodexertionassessment": {
      "parameters": [
        "individual",
        "individual",
        "individual",
        "individual",
        "situation",
        "situation",
        "individual"
      ],
      "result": "truth",
      "arguments": [
        "effort_agent",
        "beneficiary",
        "dimension",
        "method",
        "start",
        "end",
        "degree"
      ],
      "meaning_ja": "同じ受益者のための同じ方法・開始・結果への経路について、指定実施者に必要な力の投入を、指定した種類と尺度の程度として評価する。数量的な仕事量や主観的な煩わしさとは限らない。実際の実行や成功は含めず、別の人の努力・別の結果を流用しない。尺度・種類・測定の妥当性は文脈で与える。"
    },
    "availableexertionlimit": {
      "parameters": [
        "individual",
        "individual",
        "situation",
        "individual"
      ],
      "result": "truth",
      "arguments": [
        "actor",
        "dimension",
        "start",
        "degree"
      ],
      "meaning_ja": "本人が指定された種類の力を、この開始時点の基盤から当該活動のために投入し得る範囲の上限を、同じ尺度の程度として評価する。現在の意欲や実際の投入量、個別方法での成功、未来に訓練した別の能力とは分ける。評価欠落を最低値とみなさない。"
    },
    "qualitativedegreesequence": {
      "parameters": [
        "individual",
        "situation"
      ],
      "result": {
        "kind": "sequence",
        "element": "individual"
      },
      "arguments": [
        "dimension",
        "context"
      ],
      "meaning_ja": "指定した評価種類と基準文脈で用いる質的程度の有限列。低い順に並べる。単位間の等間隔、数値確率、観測頻度は含まない。重複・順序・両端は利用側で検査し、評価する内容の真偽に合わせて列を選び直さない。"
    },
    "contextualupperproximity": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "dimension",
