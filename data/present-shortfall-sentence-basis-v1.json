  "inherited_meaning_basis": "data/present-epoch-sentence-basis-v1.json",
  "definitions": {
    "r5va": "同じ人口・基準の到達閾値h26kcが有効で、不足の最小幅h26liが正かつその閾値以下である。大きな不足を任意の負数や到達不能な幅で判定しない。",
    "r5vb": "固定集団の非空・重複なしの完全列挙と全員の人間性、到達閾値の有効性、同じ点での全成員の評価を確認する。不足幅の基準はここには加えず、通常の到達も独立に評価できる。",
    "r5vc": "r5vbとr5vaが成立し、同じ全人口の能力割合に固定した大きな不足幅を足しても到達閾値を超えない。境界の幅も大きな不足へ含める明示的な最小幅の読み。単なる未到達・未知とは区別する。",
    "r5vd": "同じ現在人口・時代・宗教主題・質・元の現在基準で、現在能力r5tbと能力状態へ置かれうるr5tdの両分布がそれぞれ同じr5vcの大きな不足を持つ。r5taと全支援結果のr5tcを各側の評価に使う。個人別の選言を先に合併しない。",
    "r5ve": "r5vdの同じ現在と全設定を固定した第二文の不足内容。外側の評価点を現在と入れ替えず、将来にも決して可能にならないとは主張しない。",
    "r5vf": "同じ現在人口・時代・基準と宗教的な質付き能力について、全支援結果の評価が整い、能力状態へ置かれうる人の分布が同じ集団到達基準を満たす。人ごとに異なる実施者・方法・結果を許す普及の読みで、全員の同時達成を追加しない。",
    "r5vg": "第七段落第一文と同じ現在・人口・時代・主題・基準に全実施者範囲と現在の手立て・結果を供給したr5veの大きな不足内容。",
    "r5vh": "r5vgと同じ設定によるr5vfの、集団的に能力状態へ置かれうるという可能性の側。現在の能力の保有又は現実の支援成功とは区別する。",
    "r5vi": "同じ現在の既到達r5u2、又は同じ現在から能力状態へ置かれうるr5vhという二つの集団的内容の包含的選言。darin/daranが受ける対象をこの同じ能力状態と二側へ保つ。",
    "r5vj": "第二文全体と大きな不足の結びを同じ著者・第七段落の文脈へ帰属する。現在の事情、schonの既到達候補、oderの二側、auch nurの要求を下げた可能性、nochのなお残る不足、第一文からの順序を保持する。引用内容の真理を実行しない。"
  },
  "primitives": {
    "h26li": {
      "parameters": [
        "individual",
        "situation"
      ],
      "result": "number",
      "arguments": [
        "group",
        "reference"
      ],
      "meaning_ja": "同じ固定集団と解釈基準で、普及割合の到達基準h26kcからの不足が大きいとみなす最小の隔たり。結果を見る前に固定し、現在能力と能力状態へ置かれうる可能性の両分布に同じ尺度で適用する。正で到達基準以下という有効域はr5vaで確認する。原文に数値や一意の経験的閾値を補わない。"
    },
    "h26lj": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "actor",
        "person",
        "reference"
      ],
      "meaning_ja": "第七段落の同じ本人・元の現在基準で、本人を指定能力の状態へ置く実践上の手立ての実施者として検討する全範囲。個人・共同の実施者等を含め、成功する側や現に実施済みの側だけに絞らない。受動表現に特定の君主や必ず他人であるという条件を追加しない。範囲が既知の空であることと未知を区別する。"
    },
    "h26lk": {
      "parameters": [
        "individual",
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "actor",
        "person",
        "method",
        "current"
      ],
      "meaning_ja": "同じ現在の事情の下で、同じ実施者が本人に対して指定した手立てを実践上利用できる。学習・経験・機会や制度的な条件を整える等、能力状態へ置く方法の候補を扱う。現在の実施・成功・本人の既有能力は含めず、後の別の事情でのみ可能な方法を現在へ借りない。全ての結果はh26llで別に与える。"
    },
    "h26ll": {
      "parameters": [
        "individual",
        "individual",
        "individual",
        "situation",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "actor",
        "person",
        "method",
        "current",
        "result"
      ],
      "meaning_ja": "同じ現在の事情から、指定実施者の同じ本人への同じ手立てを利用した場合に得られうる結果。成功する結果だけを選ばず、失敗も含む全結果を与える。各結果で元の主題・事項・質・参照を保った本人の能力を評価する。実施済み、全結果の成功、別人の獲得を含意しない。"
    },
    "h26lm": {
      "parameters": [
        "individual",
