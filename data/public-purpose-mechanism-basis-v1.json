        "goal",
        "community",
        "work",
        "reference"
      ],
      "meaning_ja": "この閉じた内容が、同じ共同体の同じ事務を運営するための公的な目標として置かれている。政府関係者個人の私的利益だけや、実際に偶然生じた結果とは分ける。全住民の同意、目標の正当性、達成は要求しない。"
    },
    "h237m": {
      "parameters": [
        "individual",
        "situation"
      ],
      "result": "individual",
      "arguments": [
        "work",
        "reference"
      ],
      "meaning_ja": "同じ事務の説明で扱う政府の参照。組織としての政府を人間一人の意図へ置換しない。管轄関係はh237nで別に検査し、全世界で唯一の政府とはしない。"
    },
    "h237n": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "government",
        "community",
        "reference"
      ],
      "meaning_ja": "この政府が同じ政治的共同体の公的な運営・執行を指揮する制度上の立場にある。肩書だけの人物や私的な希望とは分ける。特定の君主制、道徳的正当性、あらゆる命令の実際の遵守は含意しない。"
    },
    "h237o": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "individual",
      "arguments": [
        "mechanism",
        "work",
        "reference"
      ],
      "meaning_ja": "同じ機構・事務について目的内容で用いる協調の配置。本文内で同じ配置を追跡する参照であり、存在するだけで人為性・協調・作用の成功を認定しない。"
    },
    "h237p": {
      "parameters": [
        "individual",
        {
          "kind": "function",
          "parameters": [
            "individual"
          ],
          "result": "truth"
        },
