      ],
      "text": "Ich antworte: ",
      "definitions": [
        "h236m",
        "r2zf",
        "r2zh"
      ],
      "reading": "同じ著者が先行二問への自分の回答として全文を提示する。"
    },
    {
      "range": [
        704,
        745
      ],
      "text": "der öffentliche Gebrauch seiner Vernunft ",
      "definitions": [
        "zzo",
        "r2ye",
        "r2yh"
      ],
      "reading": "各人自身の理性の公的使用。後続の定義と同じ学識者として読者世界へ向ける使用。"
    },
    {
      "range": [
        745,
        768
      ],
      "text": "muß jederzeit frei sein",
      "definitions": [
        "r2ye",
        "r2yf",
        "r2yg",
        "h235q"
      ],
      "reading": "全関連時機で同じ公的活動の自由を求める規範。実際の活動実行ではない。"
    },
    {
      "range": [
        768,
        774
      ],
      "text": ", und ",
      "definitions": [
        "r2ze"
      ],
      "reading": "公的自由の要求と唯一の可能な実現経路を連言で追加する。"
    },
    {
      "range": [
        774,
        790
      ],
      "text": "der allein kann ",
      "definitions": [
        "r2yj",
        "r2yk",
        "r2yl"
      ],
      "reading": "実現可能な経路があり、同じ啓蒙が実現する経路では公的使用の生産的関与を欠かない。"
    },
    {
      "range": [
        790,
        833
      ],
      "text": "Aufklärung unter Menschen zu Stande bringen",
      "definitions": [
        "r2ln",
        "r2xc",
        "r2yl",
        "r2ym"
      ],
      "reading": "同じ公衆の人間の自立的能力変化が集団に広がる啓蒙の実現。"
    },
    {
      "range": [
        833,
        864
      ],
      "text": "; der Privatgebrauch derselben ",
      "definitions": [
        "zzp",
        "r2yp",
        "r2yz",
        "r2z5"
      ],
      "reading": "同じ本人の理性の、委ねられた市民的職務での使用。公的使用の単なる否定ではない。"
    },
    {
      "range": [
        864,
        869
      ],
      "text": "aber ",
      "definitions": [
        "h236k",
        "r2zg",
        "r2zh"
      ],
      "reading": "理性使用の扱いについて公的自由の要求と私的制限への許可を対照する。"
    },
