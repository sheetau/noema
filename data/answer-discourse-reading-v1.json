      ],
      "text": "darf ",
      "definitions": [
        "h235u",
        "r2z2",
        "r2z3",
        "r2z4"
      ],
      "reading": "条件を満たす方針案の存在を内容の内側に置いた積極的許可。現実の実施は導かない。"
    },
    {
      "range": [
        874,
        909
