    "materialline": {
      "parameters": [
        "individual"
      ],
      "result": "truth",
      "arguments": [
        "line"
      ],
      "meaning_ja": "空間に置かれた物質線。単なる数値方向や記号とは分ける。物質の基礎説明は未完。"
    },
    "rigidbodyidealization": {
      "parameters": [
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "object",
        "context"
      ],
      "meaning_ja": "指定設定で形状を固定した剛な物体として扱う。物質軸と物差しへ共通に適用する理想化であり、加速中や全ての系で長さが等しいとの法則は含まない。"
    },
    "perpendicularmaterialaxes": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "first_line",
        "second_line",
        "context"
      ],
      "meaning_ja": "二つの物質軸の方向が直交する。局所的なユークリッド方向の内積が零という意味規約。実方向と物理的測定からの接続は未完。"
    },
    "parallelmaterialaxes": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "first_line",
        "second_line",
        "context"
      ],
      "meaning_ja": "二物質軸が幾何学的に平行。逆向きもこの関係単体では除かない。位置の一致は要求しない。"
    },
    "coincidentsupportinglines": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "first_line",
        "second_line",
        "context"
      ],
      "meaning_ja": "二物質軸の幾何学的な支持直線が重なる。物体の同一性ではなく、単なる平行より強い条件。"
    },
    "actsforpriorintention": {
      "parameters": [
        "individual",
        {
          "kind": "description",
          "result": "content"
        },
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "agent",
        "action",
        "intention",
        "scope",
        "reference"
      ],
      "meaning_ja": "agentがscopeで既にintentionの箇所に表明した同じ目標を目指すため、actionに記述された行為を手段として行うという目的関係。intentionは意図の表明箇所を指し、意図の対象・内容は別の関係で明示する。目的を意図する気持ちの新規発生に替えず、目標の達成、手段の十分性・成功や、客観的な因果関係の証明を要求しない。actionの実行と意図の同一性は合成側で保持する。"
    },
