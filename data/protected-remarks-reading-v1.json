        2386
      ],
      "text": "nicht verwehrt werden, ",
      "definitions": [
        "r33j",
        "r33k",
        "r33l",
        "r33m",
        "r33p"
      ],
      "reading": "関係する規制者へ、同じ作成・提出・両実行を禁じてはならないと要求する。"
    },
    {
      "range": [
        2386,
        2401
      ],
      "text": "als Gelehrter, ",
      "definitions": [
        "r2zi",
        "r33b",
        "r33c",
        "r33o"
      ],
      "reading": "同じ本人が学識者として理性を用い、公衆へ見解を向ける活動の立場。"
    },
    {
      "range": [
        2401,
        2435
      ],
      "text": "über die Fehler im Kriegesdienste ",
      "definitions": [
        "r326",
        "r33a",
        "h244a"
      ],
      "reading": "同じ軍務領域について、備えるべき条件の不充足という論点を扱う。"
    },
    {
      "range": [
        2435,
        2458
      ],
      "text": "Anmerkungen zu machen, ",
      "definitions": [
