      "definitions": [
        "h236k",
        "r33r"
      ],
      "reading": "同じ本人の職務内の制約と学識者としての活動を対照する。"
    },
    {
      "range": [
        2349,
        2363
      ],
      "text": "billigermaßen ",
      "definitions": [
        "h244d",
        "r33m"
      ],
      "reading": "公正・道理に照らした評価の規範源を固定する。"
    },
    {
      "range": [
