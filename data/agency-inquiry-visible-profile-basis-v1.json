  "primitives": {
    "humanperson": {
      "parameters": [
        "individual"
      ],
      "result": "truth",
      "arguments": [
        "person"
      ],
      "meaning_ja": "対象が人である。理解力・勇気・社会的地位の有無を人であることの条件にしない。"
    },
    "ownunderstandingfaculty": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "faculty",
        "person",
        "situation"
      ],
      "meaning_ja": "状況において、その理解能力はその人自身の能力である。他者の能力を使えることとは区別する。理解能力の十分さまでは主張しない。"
    },
    "understandinguse": {
      "parameters": [
        "individual",
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "person",
        "faculty",
        "act",
        "situation"
      ],
      "meaning_ja": "状況において、その人がその能力を使う行為が、その行為個体として成立する。所有だけ、能力の十分さだけ、実行可能性だけでは成立しない。"
    },
    "guidesparticularact": {
      "parameters": [
        "individual",
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "guide",
        "person",
        "act",
        "situation"
      ],
      "meaning_ja": "状況において、指導者がその人のその行為の進め方を指導している。その場にいること、別の行為を指導すること、過去に教えたことだけでは成立しない。"
    },
    "choosablemethodexecution": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "person",
        "plan",
        "situation"
      ],
      "meaning_ja": "その人がその状況で、その方法を選択して実行できる。方法の記述が存在するだけでは成立しない。"
    },
    "envisagedmethodoutcome": {
      "parameters": [
        "individual",
        "individual",
        "situation",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "person",
        "plan",
        "start",
        "outcome"
      ],
      "meaning_ja": "開始状況でその人が方法を実行した場合に、結果状況が評価対象の結果として想定される。想定結果の範囲は文脈の前提として別途定める。"
    },
    "changeprocessendpoints": {
      "parameters": [
        "individual",
        "situation",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "change",
        "before",
        "after"
      ],
      "meaning_ja": "その変化過程において、先行状況から後行状況へ移る。任意の二状況を並べることや因果関係を主張することとは区別する。"
    },
    "selectedassessmentoutcome": {
      "parameters": [
        "individual",
        "individual",
        "situation",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "person",
        "plan",
        "start",
        "outcome"
      ],
      "meaning_ja": "その人・方法・開始状況について、この読解で能力の評価対象に採った結果。全ての可能な結果を含むとは限らない。採用基準は文脈の前提であり、原文が一意に指定した基準とは扱わない。"
    },
    "facultyopportunitycandidate": {
      "parameters": [
        "individual",
        "situation",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "本人",
        "基準状況",
        "候補状況"
      ],
      "meaning_ja": "自立的な理解力使用を評価するため、その本人の基準状態に対して取る機会の候補。実際の履歴の断言ではなく、能力の文脈上の評価範囲である。"
    },
    "facultybasisretained": {
      "parameters": [
        "individual",
        "situation",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "本人",
        "基準状況",
        "候補状況"
      ],
      "meaning_ja": "本人の理解・習慣・決意・勇気など、当該行使能力の基盤として採る状態が基準から保持されていること。結論となる能力そのものの同一性を仮定せず、将来の習得後の状態で基準を置換しない。"
    },
    "externalexerciseopportunity": {
      "parameters": [
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "本人",
        "候補状況"
      ],
      "meaning_ja": "自立的使用を試みる外的な機会が与えられること。本人の技能・決意・成功・規範上の許可の成立とは別である。"
    },
    "facultyopportunitypriority": {
      "parameters": [
        "individual",
        "situation",
        "situation",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "本人",
        "基準状況",
        "優先候補",
        "劣後候補"
      ],
      "meaning_ja": "同じ本人と基準において、行使能力を評価する通常性の厳密な優先関係。成功結果を見て通常性を選び直すことは正当化しない。"
    },
    "existingbasisexercisemethod": {
      "parameters": [
        "individual",
        "individual",
        "situation",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "本人",
        "方法",
        "基準状況",
        "実行状況"
      ],
      "meaning_ja": "自立的理解力使用の評価に採る、既有の判断基盤を行使する方法の範囲。別の基盤を先に習得することを要する準備計画を、その基準時点での行使能力の方法に数えない。考える行為そのものや努力を排除する条件ではない。範囲はNoemaの準備履歴構成などで具体化できる文脈条件であり、本文から特定の測定履歴を捏造しない。"
    },
