{
  "status": "optional_protected_remarks_visible_profile",
  "document": "examples/v016/protected-remarks-visible-profile-v1.noema",
  "definitions": {},
  "primitives": {
    "assessmentconditionholds": {
      "parameters": [
        "individual",
        "individual",
        "situation",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "criterion",
        "target",
        "reference",
        "point"
      ],
      "meaning_ja": "指定対象が、この固定基準で解釈した同じ評価条件を評価点で満たす。評価条件の適用対象としての妥当性、条件の道徳的正当性、誰かの評価結果への賛同は別である。不明を不充足にしない。"
    },
    "adoptedassessmentcriterion": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "criterion",
        "target",
        "reference"
      ],
      "meaning_ja": "この固定基準では指定条件が、この対象の備えるべき性質・遂行水準を評価する条件として採られている。単なる好き嫌いや無関係な対象の条件を混ぜず、充足・不充足を見て条件を事後選択しない。採用基準が唯一または無条件に正しいとはしない。"
    },
    "remarkcollectionpart": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "notes",
        "remark",
        "reference"
      ],
      "meaning_ja": "指定された注記のまとまりの構成上、この言語的な所見・説明がその一つの部分である。対象事項について明確化・検討・指摘を行う内容の部分であり、無関係な文字列の同居とは区別する。構想された情報的まとまりも対象にでき、外部記録や制作済みを要求しない。"
    },
    "remarkcontenttopic": {
      "parameters": [
        "individual",
        "individual",
        "individual",
        {
          "kind": "description",
          "result": {
            "kind": "function",
            "parameters": [
              "individual",
              "individual",
              "situation"
            ],
            "result": "content"
          }
        },
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "remark",
        "target",
        "criterion",
        "content_family",
        "reference"
      ],
      "meaning_ja": "この所見が、同じ対象・評価条件・固定基準を指定の閉じた内容関数へ渡した内容を論点として分析・説明・指摘する。対象一般への言及だけでは足りず、所見全体を短い二値命題一つに限定しない。内容の真理、著者の断定や受け手の同意は要求しない。"
    },
    "ownworkproductionactivity": {
      "parameters": [
        "individual",
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "person",
        "activity",
        "work",
        "reference"
      ],
      "meaning_ja": "この活動の構成は、同じ本人が指定された記述作品を自分の所見として作成する活動である。既存の他人の作品を所有すること、別作品の作成とは区別する。分類・計画としての関係であり、活動の実行・制作完了・外部記録の現存は含意しない。"
    },
    "publicworksubmissionactivity": {
      "parameters": [
        "individual",
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "activity",
        "work",
        "audience",
        "reference"
      ],
      "meaning_ja": "この活動は指定作品を同じ公衆が取り上げて検討できるよう提供する活動として構成されている。単に作品名を言うこと、別作品の流通、宛先のない保管とは区別する。実際の提供・受領・読了・評価は含意しない。"
    },
    "militaryservicefield": {
      "parameters": [
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "field",
        "institution",
        "reference"
      ],
      "meaning_ja": "指定領域は、この軍事組織の軍務に関わる諸活動・仕組み・遂行のあり方を対象とする検討領域である。組織という集団そのものや一つの命令だけとは分ける。現に戦争中であることを要求せず、同種の軍務に共通する問題も排除しない。組織の軍事性は別に確認する。"
    },
    "authoredworkproduction": {
      "parameters": [
        "individual",
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "person",
        "activity",
        "work",
        "point"
      ],
      "meaning_ja": "この評価点で、同じ本人が同じ活動を通じて指定作品の記述を作り出した。単なる実行一般、他人の制作、すでにある作品の所持や複製媒体の移動だけとは区別する。作品の正しさや独創性を含意しない。"
    },
    "worksubmittedforassessment": {
      "parameters": [
        "individual",
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "activity",
        "work",
        "audience",
        "point"
      ],
      "meaning_ja": "この評価点で、同じ提供活動を通じて指定作品が同じ公衆の検討に供され、取り上げ得る状態になっている。全員の実際の受領・読了・理解・判断・同意は要求しない。単なる活動の生起や非公開の記録だけでは満たさない。"
    },
    "equitableassessmentnormsource": {
      "parameters": [
        "situation"
      ],
      "result": "individual",
      "arguments": [
        "reference"
      ],
      "meaning_ja": "この議論で行為を制限することの当否を、公正・道理に照らして評価するときに採る規範の出所。同じ事情に同じ扱いを求め、役割・他者への影響など関連する事情と、恣意的な好悪・特権を区別する評価の枠組みである。現に命令を出す者や法令の存在とは別の規範源として参照する。具体的な禁止拒否は別に記述し、この参照だけから導かない。"
    },
    "relevantpolicyregulator": {
      "parameters": [
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "regulator",
        "reference"
      ],
      "meaning_ja": "この固定基準で当該公的活動に許否の方針を課す立場となり得る者の範囲。現在許可した者・実際に禁じた者・正当な権限が認められた者だけへ絞らず、議論で関係する全ての規制主体を対象とする。具体的な役職はh235rで別に指定する。"
    }
  },
