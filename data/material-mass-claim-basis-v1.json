  "primitives": {
    "eiszn": {
      "parameters": [
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "matter",
        "context"
      ],
      "meaning_ja": "matterを同じ文脈の力学的記述で、慣性を担い位置を追跡できる物体の点状理想化として扱う。内部の広がり・形状・回転や多極構造を分解せず、機械的状態と作用を一つの代表位置へ帰属させる。座標点や数値自体を物体にせず、実際の幾何学的体積零、既に帯電していること、特定粒子種、特定の運動法則を含意しない。質量の値と正性、軌道と作用は別に接続する。"
    },
    "eiszo": {
      "parameters": [
        "individual",
        "individual",
        "individual",
        "individual",
        "situation"
      ],
      "result": "truth",
      "arguments": [
        "record",
        "matter",
        "frame",
        "event",
        "context"
      ],
      "meaning_ja": "recordが同じmatterに当該frame・event・contextで働く有向の機械的作用の力を記述するという物理的な帰属。運動量変化への作用又はそれを釣り合わせる機械的作用との比較で同定し、数値ベクトルだけで力と認めない。電気的作用に限定せず、質量係数の特定の値、運動方程式の成立、実測済みは含めない。数値・単位・力と加速度の規約は別に結ぶ。"
    },
