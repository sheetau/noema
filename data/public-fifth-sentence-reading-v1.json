    "range": [
      907,
      1216
    ],
    "text": "Durch eine Revolution wird vielleicht wohl ein Abfall von persönlichem Despotism und gewinnsüchtiger oder herrschsüchtiger Bedrükkung, aber niemals wahre Reform der Denkungsart zu Stande kommen; sondern neue Vorurtheile werden, eben sowohl als die alten, zum Leitbande des gedankenlosen großen Haufens dienen."
  },
  "clauses": [
    {
      "range": [
        907,
        929
      ],
      "text": "Durch eine Revolution ",
      "definitions": [
        "r2qx",
        "r2qg",
        "r2qr",
        "r2ml"
      ],
      "reading": "政治秩序の根幹を変えようとする同じ集団的対抗が、同じ候補内で結果を生む。成功や流血は必須にしない。"
    },
    {
      "range": [
        929,
        934
      ],
      "text": "wird ",
      "definitions": [
        "r2qs",
        "r2qt",
        "r2qu"
      ],
      "reading": "結果を同じ期間枠の起点より後に置く。現在既に起きた出来事の報告とはしない。"
    },
    {
      "range": [
        934,
        950
      ],
      "text": "vielleicht wohl ",
      "definitions": [
        "r2sf",
        "r2sg",
        "h227t",
        "h227u"
      ],
      "reading": "政治的離脱の結果を未確定とし、その可能性を認めて次の対比へ進む。"
    },
    {
      "range": [
        950,
        961
      ],
      "text": "ein Abfall ",
      "definitions": [
        "r2qe",
        "r2qd",
        "rcf"
      ],
      "reading": "同じ当事者が実際に服属関係を終える過程。単なる交代や動機の変化では足りない。"
    },
    {
      "range": [
        961,
        988
      ],
      "text": "von persönlichem Despotism ",
      "definitions": [
        "r2qa",
        "h226t",
        "h227a"
      ],
      "reading": "同じ共同体に実施された、個人の裁量への独立した抑制がない支配から離れる。"
    },
    {
      "range": [
        988,
        992
      ],
      "text": "und ",
      "definitions": [
        "r2qe"
      ],
      "reading": "同じ当事者・過程・前後点で専制と圧迫の両方への服属を終える。"
    },
    {
      "range": [
        992,
        1030
      ],
      "text": "gewinnsüchtiger oder herrschsüchtiger ",
      "definitions": [
        "r2px",
        "r2py",
        "r2pz",
        "r2qc"
      ],
      "reading": "同じ圧迫行為の目的となる過度な利得欲または支配欲。両方の併存を許す。"
    },
    {
      "range": [
        1030,
        1042
      ],
      "text": "Bedrükkung, ",
      "definitions": [
        "r2qb",
        "r2qc",
        "hzie"
      ],
      "reading": "同じ受け手の選択等を優越的圧力で制約し、不利益を実際に生む行為・仕組み。"
    },
    {
      "range": [
        1042,
        1047
      ],
      "text": "aber ",
      "definitions": [
        "r2sg",
        "h222q"
      ],
      "reading": "同じ革命の帰結について、政治的離脱の可能性と改革経路の不在を対比する。"
    },
    {
      "range": [
        1047,
        1055
      ],
      "text": "niemals ",
      "definitions": [
        "r2sa",
        "r2sc"
      ],
      "reading": "全対象革命・候補において公衆の改革と呼ぶ広がりが生じる経路を否定する。離脱成功例だけに制限しない。"
    },
    {
      "range": [
        1055,
        1084
      ],
      "text": "wahre Reform der Denkungsart ",
      "definitions": [
        "r2qp",
        "r2qn",
        "r2qm",
        "r2ql",
        "r2gy"
      ],
      "reading": "単に意見が変わることとは分け、自分の理解力と理由を使う判断の仕方への実際の変化と読む。"
    },
    {
      "range": [
        1084,
        1102
      ],
      "text": "zu Stande kommen; ",
      "definitions": [
        "r2qr",
        "r2qz",
        "r2ra"
      ],
      "reading": "二結果に共通の成立・因果の述語として読む。前半の全内容を同じ著者へ帰属する。"
    },
    {
      "range": [
        1102,
        1110
      ],
      "text": "sondern ",
      "definitions": [
        "r2sh",
        "h227v"
      ],
      "reading": "改革を否定した上で、後半の肯定的な予測を代わりに示す。政治的離脱の可能性を撤回しない。"
    },
    {
      "range": [
        1110,
        1115
      ],
      "text": "neue ",
      "definitions": [
        "r2rj",
        "h227j",
        "r2rh",
        "h227m"
      ],
      "reading": "基準時には広く採用されず、旧意見と実質的に内容が違う候補内の意見群。"
    },
    {
      "range": [
        1115,
        1127
      ],
      "text": "Vorurtheile ",
      "definitions": [
        "r2rb",
        "r2ri",
        "h224w",
        "h224x"
      ],
      "reading": "十分な根拠の吟味なしに確立した原則として採用する複数の意見。各項の実際の働きを要求する。"
    },
    {
      "range": [
        1127,
        1135
      ],
      "text": "werden, ",
      "definitions": [
        "r2rl",
        "r2rm",
        "r2rn",
        "r2ro"
      ],
      "reading": "同じ公衆と全革命候補について、起点より後の働きを予測し著者へ帰属する。"
    },
    {
      "range": [
        1135,
        1162
      ],
      "text": "eben sowohl als die alten, ",
      "definitions": [
        "r2rj",
        "r2rk",
        "h227l"
      ],
      "reading": "固定した旧意見群と同じく、未吟味の判断の理由として働く。人数・強度の数値的一致ではない。"
    },
    {
      "range": [
        1162,
        1176
      ],
      "text": "zum Leitbande ",
      "definitions": [
        "r2rx",
        "r2ru",
        "r2rv",
        "r2rw",
        "r2rs"
      ],
      "reading": "同じ意見・本人・行為・時点を、帯・子ども・歩行の身体的描写へ非字義的に対応させる。"
    },
    {
      "range": [
        1176,
        1194
      ],
      "text": "des gedankenlosen ",
      "definitions": [
        "r2rc",
        "h227i"
      ],
      "reading": "意見を同じ判断の理由に用いることの吟味がない。意識や思考能力の欠如へ強めない。"
    },
    {
      "range": [
        1194,
        1209
      ],
      "text": "großen Haufens ",
      "definitions": [
        "r2m7",
        "h223i",
        "r2rp",
        "h223l"
      ],
      "reading": "同じ大衆の人数と未吟味の働きを保ち、その集団を低く扱う呼称も別に帰属する。"
    },
    {
      "range": [
        1209,
        1216
      ],
      "text": "dienen.",
      "definitions": [
        "r2rc",
        "r2rd",
        "r2rf",
        "r2si"
      ],
      "reading": "同じ大衆で、単なる保有を越え、後続判断の理由として実際に用いられる働き。意見の意図や特定操作者を付加しない。"
    }
  ],
