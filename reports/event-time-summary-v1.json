          "einj",
          "eink",
          "einl",
          "einm",
          "einn",
          "eino",
          "einp"
        ],
        "status": "explicit_interpretive_annotation"
      },
      {
        "unit": "einstein-1905:u0018",
        "unit_sha256": "b2fea62ee64ba6bc7aae1ee4d8efb0e739ed115a90500377e2a601b982d64b9f",
        "range": [
          266,
          515
        ],
        "source": "Die „Zeit“ eines Ereignisses ist die mit dem Ereignis gleichzeitige Angabe einer am Orte des Ereignisses befindlichen, ruhenden Uhr, welche mit einer bestimmten, ruhenden Uhr, und zwar für alle Zeitbestimmungen mit der nämlichen Uhr, synchron läuft.",
