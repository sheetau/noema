  "alignment": {
    "unit": "kant-1784:u0009",
    "unit_sha256": "c719db3057e3bfe00e0791532aa4a79b4126930dca80e2042e55cf4150f1dd2b",
    "segments": [
      {
        "id": "causal_explanation",
        "node": "mw",
        "definition": "mx",
        "start": 0,
        "end": 289,
        "source": "Faulheit und Feigheit sind die Ursachen, warum ein so großer Theil der Menschen, nachdem sie die Natur längst von fremder Leitung frei gesprochen (naturaliter majorennes), dennoch gerne Zeitlebens unmündig bleiben; und warum es Anderen so leicht wird, sich zu deren Vormündern aufzuwerfen.",
        "status": "partial_explicit_reading"
      },
      {
        "id": "state_convenience",
        "node": "uo",
        "definition": "un",
        "start": 290,
        "end": 325,
        "source": "Es ist so bequem, unmündig zu sein.",
        "status": "partial_explicit_reading"
      },
      {
        "id": "three_examples",
        "node": "s3",
        "definition": "sy",
        "start": 326,
        "end": 518,
        "source": "Habe ich ein Buch, das für mich Verstand hat, einen Seelsorger, der für mich Gewissen hat, einen Arzt der für mich die Diät beurtheilt, u. s. w. so brauche ich mich ja nicht selbst zu bemühen.",
        "status": "partial_explicit_reading"
      },
      {
        "id": "payment_expectation",
        "node": "t4",
        "definition": "t3",
        "start": 519,
        "end": 647,
        "source": "Ich habe nicht nöthig zu denken, wenn ich nur bezahlen kann; andere werden das verdrießliche Geschäft schon für mich übernehmen.",
        "status": "partial_explicit_reading"
      }
    ],
