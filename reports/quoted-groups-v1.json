    "segments": [
      {
        "id": "definition-enlightenment",
        "start": 0,
        "end": 85,
        "source": "Aufklärung ist der Ausgang des Menschen aus seiner selbst verschuldeten Unmündigkeit.",
        "node": "first",
        "relation": "ua",
        "definition": "bi",
        "status": "partial",
        "reading": "draft"
      },
      {
        "id": "definition-immaturity",
        "start": 86,
        "end": 181,
        "source": "Unmündigkeit ist das Unvermögen, sich seines Verstandes ohne Leitung eines anderen zu bedienen.",
        "node": "second",
        "relation": "ua",
        "definition": "bf",
        "status": "partial",
        "reading": "draft"
      },
      {
        "id": "definition-self-incurred",
        "start": 182,
        "end": 381,
        "source": "Selbstverschuldet ist diese Unmündigkeit, wenn die Ursache derselben nicht am Mangel des Verstandes, sondern der Entschließung und des Muthes liegt, sich seiner ohne Leitung eines andern zu bedienen.",
        "node": "third",
        "relation": "ua",
        "definition": "bp",
        "status": "partial",
        "reading": "draft"
      },
      {
        "id": "latin-motto",
        "start": 382,
        "end": 394,
        "source": "Sapere aude!",
        "node": "latin",
        "relation": "ub",
        "definition": "bl",
        "status": "partial",
        "reading": "independent_lexical_review_compositional_discernment_candidate"
      },
      {
        "id": "imperative",
        "start": 395,
        "end": 448,
        "source": "Habe Muth dich deines eigenen Verstandes zu bedienen!",
        "node": "german",
        "relation": "ub",
